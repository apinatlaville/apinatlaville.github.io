<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mes Cours</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
:root{
  --bg:#0c0c10;--s1:#141418;--s2:#1c1c22;--s3:#252530;
  --bd:#2a2a3a;--acc:#5b8df7;--glow:rgba(91,141,247,.18);
  --gold:#f0c060;--grn:#50d890;--red:#f06060;--pur:#b06af7;
  --txt:#e4e4f0;--mut:#6a6a88;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--txt);font-family:'DM Sans',sans-serif;min-height:100vh;padding-bottom:90px;}

.hdr{background:linear-gradient(150deg,#0e1628,#0c0c10);padding:22px 16px 18px;border-bottom:1px solid var(--bd);}
.hdr h1{font-family:'Syne',sans-serif;font-size:24px;font-weight:800;letter-spacing:-.5px;}
.hdr h1 span{color:var(--acc);}
.hdr p{color:var(--mut);font-size:13px;margin-top:4px;}

.sbar{background:var(--s1);border-bottom:1px solid var(--bd);padding:12px 16px;display:flex;gap:8px;align-items:center;position:sticky;top:0;z-index:50;}
.inp{width:100%;background:var(--s2);border:1.5px solid var(--bd);border-radius:10px;padding:10px 14px;color:var(--txt);font-family:'DM Sans',sans-serif;font-size:14px;outline:none;transition:all .2s;}
.inp:focus{border-color:var(--acc);box-shadow:0 0 0 3px var(--glow);}
.inp-mono{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:1px;color:var(--acc);}
.btn{border:none;border-radius:9px;padding:10px 15px;font-family:'Syne',sans-serif;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;transition:transform .1s,opacity .2s;}
.btn:active{transform:scale(.96);}
.b-acc{background:var(--acc);color:#fff;}
.b-out{background:transparent;border:1px solid var(--bd);color:var(--txt);}
.b-out:hover{background:var(--s2);}

.tabs{display:flex;padding:14px 16px 0;border-bottom:1px solid var(--bd);gap:4px;overflow-x:auto;}
.tabs::-webkit-scrollbar{display:none;}
.tab{background:none;border:none;color:var(--mut);font-family:'Syne',sans-serif;font-size:14px;font-weight:700;padding:10px 16px;cursor:pointer;border-radius:8px 8px 0 0;position:relative;white-space:nowrap;}
.tab.on{color:var(--txt);background:var(--s2);}
.tab.on::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--acc);border-radius:2px 2px 0 0;}

.pane{padding:16px;}
.hidden{display:none!important;}
.empty{text-align:center;padding:50px 20px;color:var(--mut);}

/* GRID & CARDS */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;}
.card{background:var(--s1);border:1px solid var(--bd);border-radius:14px;padding:16px;position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;}
.ctop{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;gap:8px;}
.ccodes{display:flex;gap:6px;flex-wrap:wrap;}
.tg{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.5px;padding:3px 8px;border-radius:6px;background:var(--s2);color:var(--mut);border:1px solid var(--bd);}
.tg-u{background:rgba(91,141,247,.1);color:var(--acc);border-color:var(--acc);}
.tg-wrn{background:rgba(240,96,96,.1);color:var(--red);border-color:var(--red);}
.acts{display:flex;gap:4px;}
.abt{background:var(--s2);border:1px solid var(--bd);color:var(--txt);cursor:pointer;width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px;transition:background .2s;}
.abt:hover{background:var(--s3);}
.ctit{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;margin-bottom:8px;line-height:1.3;}
.cloc{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
.clc{font-size:12px;padding:3px 8px;border-radius:6px;background:var(--s2);color:var(--txt);}
.cdesc{font-size:13px;color:var(--mut);line-height:1.5;}

/* PRINT PANE */
.pbar{background:var(--s2);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;}
.pcard{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:12px;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;cursor:pointer;transition:border-color .2s;}
.pcard:hover{border-color:var(--acc);}
.pcard.sel{border-color:var(--acc);background:rgba(91,141,247,.05);}
.pc-qr{background:#fff;padding:6px;border-radius:8px;margin-bottom:8px;width:100px;height:100px;display:flex;align-items:center;justify-content:center;}
.pc-lbl{font-family:'DM Mono',monospace;font-size:11px;color:var(--acc);margin-bottom:4px;font-weight:500;}
.pc-tit{font-size:11px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;width:100%;}
.pc-chk{position:absolute;top:8px;right:8px;accent-color:var(--acc);width:16px;height:16px;pointer-events:none;}

/* MODALS */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(4px);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;}
.mod{background:var(--s1);border:1px solid var(--bd);border-radius:18px;padding:22px;width:100%;max-width:420px;max-height:90vh;overflow-y:auto;position:relative;}
.mod h2{font-family:'Syne',sans-serif;font-size:18px;font-weight:800;margin-bottom:16px;}
.close{position:absolute;top:18px;right:18px;background:none;border:none;color:var(--mut);font-size:22px;cursor:pointer;line-height:1;}
.fg{margin-bottom:14px;}
.fg label{display:block;font-size:12px;font-weight:500;color:var(--mut);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px;}
.uidbox{background:var(--s3);border:1px solid var(--bd);border-radius:10px;padding:12px;font-family:'DM Mono',monospace;font-size:16px;letter-spacing:2px;color:var(--acc);text-align:center;margin-bottom:14px;}
.uidbox small{display:block;font-size:11px;color:var(--mut);letter-spacing:normal;margin-top:4px;font-family:'DM Sans',sans-serif;}
.macts{display:flex;gap:8px;margin-top:20px;}
.macts .btn{flex:1;}

/* QR & CAM MODAL */
.mod-mid{text-align:center;}
.qrwrap{display:inline-block;background:#fff;padding:12px;border-radius:12px;margin:16px 0;}
.qrlbl{font-family:'DM Mono',monospace;font-size:14px;letter-spacing:1.5px;color:var(--acc);margin-bottom:8px;}
.qrsub{font-size:13px;color:var(--mut);}
.camw{width:100%;max-width:300px;margin:0 auto 16px;border-radius:14px;overflow:hidden;background:#000;aspect-ratio:1;border:2px solid var(--bd);}
#cvid{width:100%;height:100%;object-fit:cover;display:block;}

/* LOCALISER MODAL */
.loc-box { background:var(--s2); padding:15px; border-radius:12px; margin-bottom:15px; text-align: left;}

/* FAB */
.fabs{position:fixed;bottom:24px;right:24px;display:flex;flex-direction:column;gap:12px;z-index:90;}
.fab{width:54px;height:54px;border-radius:50%;border:none;color:#fff;font-size:24px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;transition:transform .2s;}
.fab:hover{transform:scale(1.08);}
.f-add{background:var(--acc);}
.f-csv{background:var(--grn);color:#0c0c10;width:44px;height:44px;font-size:18px;margin-left:10px;}

/* IMPRESSION */
@media print {
  body * { visibility: hidden !important; }
  #printZone, #printZone * { visibility: visible !important; }
  #printZone { position: absolute; left: 0; top: 0; width: 100%; display: flex; flex-wrap: wrap; gap: 15px; padding: 10mm; background: #fff;}
  .pcard { 
    border: 1px dashed #000 !important; 
    width: 130px; 
    padding: 10px; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    page-break-inside: avoid;
    background: transparent !important;
  }
  .pcard input[type="checkbox"], .pcard .acts, .pbar, .tabs, .sbar, .hdr { display: none !important; }
  
  /* CRUCIAL POUR L'IMPRESSION DU QR CODE */
  .pc-qr canvas { display: none !important; }
  .pc-qr img { display: block !important; margin: 0 auto; width: 100px; height: 100px; }
  
  .pc-lbl { font-family: 'DM Mono', monospace; font-size: 11px; font-weight: bold; color: #000 !important; margin-top: 5px;}
  .pc-tit { display: none !important; } /* On cache le titre pour gagner de la place si on veut juste les stickers */
}
</style>
</head>
<body>

<header class="hdr">
  <h1>📚 Mes <span>Cours</span></h1>
  <p>Localisation et Impression d'étiquettes QR</p>
</header>

<div class="sbar">
  <input type="text" id="bigSearch" class="inp inp-mono" placeholder="🔎 RECHERCHER UN CODE OU TITRE (TAPE ENTRÉE POUR LOCALISER)">
  <button class="btn b-out" id="btnCam">📷</button>
</div>

<div class="tabs">
  <button class="tab on" data-tab="cours">📋 Liste</button>
  <button class="tab" data-tab="print">🖨️ Impression</button>
  <button class="tab" data-tab="cl">🗂️ Classeurs</button>
  <button class="tab" data-tab="mat">🏷️ Matières</button>
</div>

<div class="pane" id="paneCours">
  <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
    <select id="fltMat" class="inp" style="flex:1;min-width:110px"></select>
    <select id="fltCl" class="inp" style="flex:1;min-width:110px"></select>
    <select id="fltQr" class="inp" style="flex:1;min-width:130px">
      <option value="">Tous les états QR</option>
      <option value="no">QR Non Imprimé</option>
      <option value="yes">QR Imprimé</option>
    </select>
  </div>
  <div class="grid" id="cg"></div>
</div>

<div class="pane hidden" id="panePrint">
  <div class="pbar">
    <div>
      <h3 style="font-family:'Syne';font-size:16px;margin-bottom:4px;">Sélection</h3>
      <p style="color:var(--mut);font-size:12px;" id="pStats">0 cours sélectionnés</p>
    </div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;">
      <button class="btn b-out" id="btnSelPending">Nouveaux</button>
      <button class="btn b-out" id="btnSelAll">Tous</button>
      <button class="btn b-out" id="btnDesel">Aucun</button>
      <button class="btn b-acc" id="btnDoPrint">🖨️ Imprimer</button>
      <button class="btn b-out" id="btnMarkPrinted">✅ Marquer Imprimés</button>
    </div>
  </div>
  <div class="pgrid" id="pg"></div>
</div>

<div class="pane hidden" id="paneCl"><div class="empty">Gestion des classeurs (à coder)</div></div>
<div class="pane hidden" id="paneMat"><div class="empty">Gestion des matières (à coder)</div></div>

<div class="fabs">
  <button class="fab f-csv" id="fabCsv" title="Exporter CSV">📄</button>
  <button class="fab f-add" id="fabAdd" title="Ajouter">+</button>
</div>

<div id="printZone" class="hidden"></div>

<div class="ov hidden" id="ovLoc">
  <div class="mod mod-mid">
    <button class="close" id="btnCloseLoc">✕</button>
    <h2 style="color: var(--acc);">📍 Cours Localisé</h2>
    <div id="locContent"></div>
  </div>
</div>

<div class="ov hidden" id="ovCours">
  <div class="mod">
    <button class="close" id="btnCancelCours">✕</button>
    <h2 id="mTitle">✏️ Cours</h2>
    <div class="fg"><label>Titre *</label><input type="text" id="fTitle" class="inp"></div>
    <div style="display:flex;gap:10px;">
      <div class="fg" style="flex:1"><label>Matière *</label><select id="fMat" class="inp"></select></div>
      <div class="fg" style="flex:1"><label>Classeur *</label><select id="fCl" class="inp"></select></div>
    </div>
    <div class="fg">
      <label>Intercalaire *</label>
      <select id="fInter" class="inp">
        <option value="">—</option><option value="1">1</option><option value="2">2</option>
        <option value="3">3</option><option value="4">4</option><option value="5">5</option>
        <option value="6">6</option><option value="7">7</option><option value="8">8</option>
        <option value="9">9</option><option value="10">10</option>
      </select>
    </div>
    <div class="uidbox" id="uidBox">—</div>
    <div class="fg"><label>Description</label><textarea id="fDesc" class="inp" rows="2"></textarea></div>
    <div class="fg"><label>Date</label><input type="date" id="fDate" class="inp"></div>
    <div class="macts">
      <button class="btn b-acc" id="btnSaveCours">💾 Enregistrer</button>
    </div>
  </div>
</div>

<div class="ov hidden" id="ovQR">
  <div class="mod mod-mid">
    <button class="close" id="btnCloseQR">✕</button>
    <h2 id="qrTitle">📱 QR</h2>
    <div class="qrsub" id="qrSub"></div>
    <div class="qrwrap" id="qrWrap"></div>
    <div class="qrlbl" id="qrLbl"></div>
  </div>
</div>

<div class="ov hidden" id="ovCam">
  <div class="mod mod-mid">
    <h2 style="margin-bottom:8px">📷 Scanner</h2>
    <p style="font-size:13px;color:var(--mut);margin-bottom:16px">Pointe un QR code pour le localiser</p>
    <div class="camw"><video id="cvid" autoplay playsinline muted></video></div>
    <canvas id="ccanv" style="display:none"></canvas>
    <div id="cst" style="font-size:13px;color:var(--mut);margin-bottom:16px">Lancement...</div>
    <button class="btn b-out" id="btnStopCam" style="width:100%">Annuler</button>
  </div>
</div>

<script>
(function(){
'use strict';

const IN = ['','Intro','Cours 1','Cours 2','Cours 3','Cours 4','Cours 5','Exercices','TD','TP','Fiches'];

// DONNÉES : J'ai mis des codes simples (AA, BB, CC) pour que tu puisses tester la recherche / le QR hors-ligne
let D = JSON.parse(localStorage.getItem('mc_v8') || 'null') || {
  mat: [ {id:'PHYS',n:'Physique',c:'#5b8df7'}, {id:'MATH',n:'Maths',c:'#f0c060'} ],
  cl: [ {id:'A',n:'Classeur Phys A',i:'📘'}, {id:'C',n:'Classeur Maths',i:'📙'} ],
  cours: [
    {uid:'AA', title:'Chapitre 1 — Mécanique', mat:'PHYS', cl:'A', inter:1, desc:'Test QR Code A', d:'2024-03-01', qrPrinted:false},
    {uid:'BB', title:'Chapitre 2 — Ondes', mat:'PHYS', cl:'A', inter:2, desc:'Test QR Code B', d:'2024-03-15', qrPrinted:false},
    {uid:'CC', title:'Suites numériques', mat:'MATH', cl:'C', inter:1, desc:'Pour tester', d:'2024-03-10', qrPrinted:true}
  ]
};

let editUid = null;
let printSel = new Set();
let camStr = null;
let camTck = null;

const save = () => localStorage.setItem('mc_v8', JSON.stringify(D));
const $ = id => document.getElementById(id);

// ── UID SYSTEM ──
// L'UID ne dépend plus de l'intercalaire. Il est généré une fois et reste fixe.
function genUid(mat) {
  return mat + '-' + Math.random().toString(36).substring(2, 6).toUpperCase();
}

function updateUid() {
  const mat = $('fMat').value;
  if(editUid) {
    $('uidBox').innerHTML = editUid + '<small>(Code Fixe)</small>';
  } else if(mat) {
    $('uidBox').innerHTML = '<span style="color:var(--mut)">Généré auto</span><small>Sera lié à '+mat+'</small>';
  } else {
    $('uidBox').innerHTML = '—<small>Choisis une matière</small>';
  }
}

// ── ONGLETS ──
function switchTab(t) {
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b.dataset.tab===t));
  ['cours','print','cl','mat'].forEach(x => {
    $('pane'+x.charAt(0).toUpperCase()+x.slice(1)).classList.toggle('hidden', x!==t);
  });
  if(t==='print') renderPrintGrid();
}

// ── RENDU COURS ──
function renderCours() {
  const s = $('bigSearch').value.toUpperCase().trim();
  const fm = $('fltMat').value, fc = $('fltCl').value, fq = $('fltQr').value;
  
  let list = D.cours.filter(c => {
    if(fm && c.mat !== fm) return false;
    if(fc && c.cl !== fc) return false;
    if(fq === 'no' && c.qrPrinted) return false;
    if(fq === 'yes' && !c.qrPrinted) return false;
    if(s && !c.uid.includes(s) && !c.title.toUpperCase().includes(s)) return false;
    return true;
  });

  const grid = $('cg');
  if(!list.length) { grid.innerHTML='<div class="empty">Aucun cours trouvé.</div>'; return; }

  grid.innerHTML = list.map(c => {
    const m = D.mat.find(x=>x.id===c.mat)||{n:c.mat,c:'#6a6a88'};
    const k = D.cl.find(x=>x.id===c.cl)||{n:c.cl,i:'📁'};
    return `
      <div class="card" style="border-left-color:${m.c}">
        <div class="ctop">
          <div class="ccodes">
            <span class="tg" style="border-color:${m.c};color:${m.c}">${m.n}</span>
            <span class="tg tg-u">${c.uid}</span>
            ${!c.qrPrinted ? '<span class="tg tg-wrn">🖨️ À imprimer</span>' : ''}
          </div>
          <div class="acts">
            <button class="abt" onclick="showQR('${c.uid}')">🔳</button>
            <button class="abt" onclick="editCours('${c.uid}')">✏️</button>
          </div>
        </div>
        <div class="ctit">${c.title}</div>
        <div class="cloc">
          <span class="clc">${k.i} ${k.n}</span>
          <span class="clc">📑 Inter. ${c.inter}</span>
        </div>
        ${c.desc ? `<div class="cdesc">${c.desc}</div>` : ''}
      </div>`;
  }).join('');
}

// ── LOCALISER (MODAL) ──
function doLocate(uid) {
  const c = D.cours.find(x => x.uid === uid);
  if(!c) { alert('❌ Code introuvable : ' + uid); return; }
  
  const m = D.mat.find(x => x.id === c.mat) || {n:c.mat,c:'#5b8df7'};
  const k = D.cl.find(x => x.id === c.cl) || {n:c.cl,i:'📁'};
  
  $('locContent').innerHTML = `
    <div style="font-family:'DM Mono',monospace;font-size:24px;text-align:center;margin-bottom:15px;color:${m.c}">${c.uid}</div>
    <div class="loc-box">
      <h3 style="margin-bottom:8px;">${c.title}</h3>
      <p style="color:var(--mut);font-size:13px;margin-bottom:4px;">Matière : <strong style="color:var(--txt)">${m.n}</strong></p>
      <p style="color:var(--mut);font-size:13px;">${c.desc || 'Pas de description.'}</p>
    </div>
    <div style="border:1px solid var(--grn);background:rgba(80,216,144,.07);padding:15px;border-radius:12px;text-align:center;">
      <p style="font-size:12px;color:var(--grn);margin-bottom:10px;text-transform:uppercase;font-weight:bold;">📍 Emplacement Physique</p>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;justify-content:center;">
        <span style="font-size:20px;">${k.i}</span> <b style="font-size:16px">${k.n}</b>
      </div>
      <div style="display:flex;align-items:center;gap:8px;justify-content:center;">
        <span style="font-size:20px;">📑</span> <b style="font-size:15px">Intercalaire ${c.inter} — ${IN[c.inter]||''}</b>
      </div>
    </div>
  `;
  $('ovLoc').classList.remove('hidden');
}

// Gestion Entrée sur la barre de recherche
$('bigSearch').addEventListener('keydown', e => {
  if(e.key === 'Enter') {
    const val = e.target.value.trim().toUpperCase();
    if(val) doLocate(val);
  }
});
$('btnCloseLoc').addEventListener('click', () => $('ovLoc').classList.add('hidden'));

// ── IMPRESSION TAB ──
window.toggleSel = function(uid) {
  if(printSel.has(uid)) printSel.delete(uid); else printSel.add(uid);
  renderPrintGrid();
}

function renderPrintGrid() {
  const grid = $('pg');
  if(!D.cours.length) { grid.innerHTML='<div class="empty">Aucun cours.</div>'; return; }
  
  grid.innerHTML = D.cours.map(c => {
    const isSel = printSel.has(c.uid);
    return `
      <div class="pcard ${isSel?'sel':''}" onclick="toggleSel('${c.uid}')">
        <input type="checkbox" class="pc-chk" ${isSel?'checked':''}>
        <div class="pc-qr" id="print-qr-${c.uid}"></div>
        <div class="pc-lbl">${c.uid}</div>
        <div class="pc-tit">${c.title}</div>
      </div>`;
  }).join('');
  
  $('pStats').textContent = printSel.size + ' cours sélectionné(s)';

  // Génération des QR en différé pour laisser le DOM s'actualiser
  setTimeout(() => {
    D.cours.forEach(c => {
      const el = $('print-qr-' + c.uid);
      if(el) {
        el.innerHTML = '';
        new QRCode(el, { text: c.uid, width: 88, height: 88, colorDark: "#000000", colorLight: "#ffffff" });
      }
    });
  }, 0);
}

function doPrint() {
  if(printSel.size===0){alert('Sélectionne des codes à imprimer.');return;}
  const z = $('printZone'); z.innerHTML='';
  
  // On clone les éléments sélectionnés dans la printZone
  printSel.forEach(uid => {
    const c = D.cours.find(x=>x.uid===uid); if(!c) return;
    const d = document.createElement('div');
    d.className = 'pcard';
    d.innerHTML = `
      <div class="pc-qr" id="pz-qr-${uid}"></div>
      <div class="pc-lbl">${uid}</div>
      <div class="pc-tit">${c.title}</div>
    `;
    z.appendChild(d);
    new QRCode(d.querySelector('.pc-qr'), { text: uid, width: 100, height: 100 });
  });

  // Petite pause pour laisser le canvas se dessiner avant d'imprimer
  setTimeout(() => { window.print(); }, 400);
}

function markPrinted() {
  if(printSel.size===0) return;
  D.cours.forEach(c=>{ if(printSel.has(c.uid)) c.qrPrinted=true; });
  save(); printSel.clear(); renderPrintGrid(); renderCours();
}

// ── MODAL QR UNIQUE ──
window.showQR = function(uid) {
  const c = D.cours.find(x=>x.uid===uid); if(!c) return;
  const m = D.mat.find(x=>x.id===c.mat)||{n:c.mat};
  const k = D.cl.find(x=>x.id===c.cl)||{n:c.cl};
  $('qrTitle').textContent = '📱 ' + c.title;
  $('qrSub').textContent = m.n + ' · ' + k.n + ' · Inter ' + c.inter;
  $('qrLbl').textContent = uid;
  
  $('qrWrap').innerHTML = ''; // Nettoyage
  new QRCode($('qrWrap'), { text: uid, width: 180, height: 180 });
  
  $('ovQR').classList.remove('hidden');
}
function closeQR() { $('ovQR').classList.add('hidden'); }

// ── MODAL COURS ──
function popSels() {
  $('fMat').innerHTML='<option value="">— Choisir —</option>'+D.mat.map(x=>`<option value="${x.id}">${x.n}</option>`).join('');
  $('fCl').innerHTML='<option value="">— Choisir —</option>'+D.cl.map(x=>`<option value="${x.id}">${x.i} ${x.n}</option>`).join('');
  $('fltMat').innerHTML='<option value="">Toutes matières</option>'+D.mat.map(x=>`<option value="${x.id}">${x.n}</option>`).join('');
  $('fltCl').innerHTML='<option value="">Tous classeurs</option>'+D.cl.map(x=>`<option value="${x.id}">${x.i} ${x.n}</option>`).join('');
}

window.editCours = function(uid) {
  const c = D.cours.find(x=>x.uid===uid); if(!c) return;
  editUid = uid;
  $('mTitle').textContent = '✏️ Modifier';
  $('fTitle').value = c.title;
  $('fMat').value = c.mat; $('fCl').value = c.cl; $('fInter').value = c.inter;
  $('fDesc').value = c.desc||''; $('fDate').value = c.d||'';
  updateUid();
  $('ovCours').classList.remove('hidden');
}

function openModal() {
  editUid = null;
  $('mTitle').textContent = '✨ Nouveau cours';
  $('fTitle').value=''; $('fMat').value=''; $('fCl').value=''; $('fInter').value='';
  $('fDesc').value=''; $('fDate').value=new Date().toISOString().split('T')[0];
  updateUid();
  $('ovCours').classList.remove('hidden');
}
function closeModal() { $('ovCours').classList.add('hidden'); }

function saveCours() {
  const title=$('fTitle').value.trim(), mat=$('fMat').value, cl=$('fCl').value, inter=parseInt($('fInter').value);
  if(!title||!mat||!cl||!inter){alert('Champs avec * requis');return;}
  
  const obj = { title, mat, cl, inter, desc:$('fDesc').value.trim(), d:$('fDate').value, qrPrinted:false };
  
  if(editUid) { 
    const idx = D.cours.findIndex(c=>c.uid===editUid); 
    if(idx > -1) {
      obj.uid = D.cours[idx].uid; // On ne change PAS l'UID
      obj.qrPrinted = D.cours[idx].qrPrinted;
      D.cours[idx] = obj; 
    }
  } else { 
    obj.uid = genUid(mat); 
    D.cours.unshift(obj); 
  }
  save(); closeModal(); renderCours(); renderPrintGrid();
}

// ── SCAN CAMERA (jsQR CDN) ──
function openCam() {
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){alert('Caméra indisponible.');return;}
  $('ovCam').classList.remove('hidden');
  $('cst').textContent = 'Accès caméra...';
  navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}})
    .then(s => {
      camStr=s; const v=$('cvid'); v.srcObject=s; v.play();
      $('cst').textContent = '🔍 Recherche du QR code...';
      if(window.jsQR){ camTck=setInterval(()=>scanFrame(v),250); return; }
      const sc = document.createElement('script');
      sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js';
      sc.onload = ()=>camTck=setInterval(()=>scanFrame(v),250);
      document.head.appendChild(sc);
    })
    .catch(e => $('cst').textContent='Erreur: '+e.message);
}
function scanFrame(v) {
  if(v.readyState!==4||!window.jsQR) return;
  const cv=$('ccanv'); cv.width=v.videoWidth; cv.height=v.videoHeight;
  const cx=cv.getContext('2d'); cx.drawImage(v,0,0);
  const d=cx.getImageData(0,0,cv.width,cv.height);
  const code=jsQR(d.data,d.width,d.height,{inversionAttempts:'dontInvert'});
  if(code && code.data) {
    const uid = code.data.trim().toUpperCase();
    stopCam();
    $('bigSearch').value = uid; // Met à jour la barre
    doLocate(uid); // Lance la popup de localisation directe !
    renderCours();
  }
}
function stopCam() {
  if(camTck){clearInterval(camTck);camTck=null;}
  if(camStr){camStr.getTracks().forEach(t=>t.stop());camStr=null;}
  const v=$('cvid'); if(v) v.srcObject=null;
  $('ovCam').classList.add('hidden');
}

// ── CSV EXPORT ──
function exportCSV() {
  const rows = [['UID','Titre','Matiere','Classeur','Intercalaire','Date','Imprime']];
  D.cours.forEach(c => rows.push([c.uid,`"${c.title}"`,c.mat,c.cl,c.inter,c.d||'',c.qrPrinted?'Oui':'Non']));
  const csv = rows.map(r=>r.join(',')).join('\n');
  const b = new Blob([csv],{type:'text/csv;charset=utf-8;'});
  const l = document.createElement('a'); l.href=URL.createObjectURL(b); l.download='mes_cours.csv'; l.click();
}

// ── INIT EVENTS ──
$('fabAdd').addEventListener('click', openModal);
$('btnCam').addEventListener('click', openCam);
$('fabCsv').addEventListener('click', exportCSV);
$('btnCancelCours').addEventListener('click', closeModal);
$('btnSaveCours').addEventListener('click', saveCours);
$('fMat').addEventListener('change', updateUid);
$('btnCloseQR').addEventListener('click', closeQR);
$('btnStopCam').addEventListener('click', stopCam);
$('bigSearch').addEventListener('input', renderCours);
$('fltMat').addEventListener('change', renderCours);
$('fltCl').addEventListener('change', renderCours);
$('fltQr').addEventListener('change', renderCours);

// Impression Events
$('btnSelAll').addEventListener('click',()=>{ printSel=new Set(D.cours.map(c=>c.uid)); renderPrintGrid(); });
$('btnSelPending').addEventListener('click',()=>{ printSel=new Set(D.cours.filter(c=>!c.qrPrinted).map(c=>c.uid)); renderPrintGrid(); });
$('btnDesel').addEventListener('click',()=>{ printSel.clear(); renderPrintGrid(); });
$('btnDoPrint').addEventListener('click', doPrint);
$('btnMarkPrinted').addEventListener('click', markPrinted);

document.querySelectorAll('.tab').forEach(b=>{b.addEventListener('click',()=>switchTab(b.dataset.tab));});

popSels();
renderCours();

})();
</script>
