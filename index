<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mes Cours</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0c0c10;--sur:#141418;--sur2:#1c1c22;--sur3:#242430;
  --bdr:#2a2a38;--acc:#5b8df7;--glow:rgba(91,141,247,.2);
  --gold:#f0c060;--grn:#50d890;--red:#f06060;
  --txt:#e4e4f0;--mut:#6a6a88;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--txt);font-family:'DM Sans',sans-serif;min-height:100vh;padding-bottom:80px;}
header{background:linear-gradient(150deg,#0e1628,#0c0c10);padding:24px 16px 18px;border-bottom:1px solid var(--bdr);}
header h1{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;}
header h1 span{color:var(--acc);}
header p{color:var(--mut);font-size:13px;margin-top:3px;}

/* SCANNER */
.sbar{background:var(–sur);border-bottom:1px solid var(–bdr);padding:10px 14px;display:flex;gap:7px;align-items:center;flex-wrap:wrap;}
.slbl{font-size:11px;color:var(–mut);font-family:‘DM Mono’,monospace;white-space:nowrap;}
.swrap{flex:1;min-width:120px;}
#scanInput{width:100%;background:var(–sur2);border:1.5px solid var(–bdr);border-radius:9px;padding:9px 12px;color:var(–acc);font-family:‘DM Mono’,monospace;font-size:14px;letter-spacing:2px;text-transform:uppercase;outline:none;transition:border-color .2s,box-shadow .2s;}
#scanInput:focus{border-color:var(–acc);box-shadow:0 0 0 3px var(–glow);}
.sbtn{border:none;border-radius:8px;padding:9px 13px;font-family:‘Syne’,sans-serif;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;transition:opacity .2s;}
.sbtn-loc{background:var(–acc);color:#fff;}
.sbtn-cam{background:var(–sur2);border:1px solid var(–bdr);color:var(–txt);}
.sbtn-csv{background:var(–grn);color:#0c0c10;}
.sbtn:hover{opacity:.85;}

/* SCAN RESULT */
.sres{margin:9px 14px 0;border-radius:11px;padding:13px 15px;display:none;}
.sres.found{border:1px solid var(–grn);background:rgba(80,216,144,.07);}
.sres.notfound{border:1px solid var(–red);background:rgba(240,96,96,.07);}
.rcode{font-family:‘DM Mono’,monospace;font-size:16px;letter-spacing:2px;color:var(–acc);margin-bottom:8px;}
.rloc{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
.lb{display:flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:500;}
.lb-cl{background:rgba(91,141,247,.15);color:var(–acc);border:1px solid var(–acc);}
.lb-in{background:rgba(240,192,96,.15);color:var(–gold);border:1px solid var(–gold);}
.lb-nu{background:rgba(80,216,144,.15);color:var(–grn);border:1px solid var(–grn);}
.rtitle{font-family:‘Syne’,sans-serif;font-size:14px;font-weight:700;}
.rsub{color:var(–mut);font-size:12px;margin-top:3px;}

/* STATS */
.stbar{display:flex;gap:6px;padding:10px 14px;background:var(–sur);border-bottom:1px solid var(–bdr);overflow-x:auto;scrollbar-width:none;}
.stbar::-webkit-scrollbar{display:none;}
.sc{display:flex;align-items:center;gap:5px;background:var(–sur2);border:1px solid var(–bdr);border-radius:20px;padding:4px 10px;font-size:11px;white-space:nowrap;flex-shrink:0;}
.dot{width:7px;height:7px;border-radius:50%;}

/* TABS */
.tabs{display:flex;padding:12px 14px 0;border-bottom:1px solid var(–bdr);gap:2px;overflow-x:auto;scrollbar-width:none;}
.tabs::-webkit-scrollbar{display:none;}
.tb{background:none;border:none;color:var(–mut);font-family:‘Syne’,sans-serif;font-size:13px;font-weight:700;padding:9px 14px;cursor:pointer;border-radius:7px 7px 0 0;transition:all .2s;position:relative;white-space:nowrap;}
.tb.on{color:var(–txt);background:var(–sur2);}
.tb.on::after{content:’’;position:absolute;bottom:0;left:0;right:0;height:2px;background:var(–acc);border-radius:2px 2px 0 0;}

/* CONTENT */
.pane{padding:14px;}
.fi{background:var(–sur2);border:1px solid var(–bdr);border-radius:8px;padding:8px 11px;color:var(–txt);font-family:‘DM Sans’,sans-serif;font-size:13px;outline:none;transition:border-color .2s;cursor:pointer;width:100%;}
.fi:focus{border-color:var(–acc);}
.frow{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;}
.fgrow{flex:1;min-width:130px;}
.chips{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px;}
.chip{padding:4px 11px;border-radius:20px;border:1.5px solid var(–bdr);background:transparent;color:var(–mut);font-size:12px;font-family:‘Syne’,sans-serif;font-weight:700;cursor:pointer;transition:all .15s;}
.chip.on{background:var(–acc);border-color:var(–acc);color:#fff;}

/* CARDS */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px;}
.card{background:var(–sur);border:1px solid var(–bdr);border-radius:12px;padding:14px;transition:all .2s;position:relative;overflow:hidden;}
.card::before{content:’’;position:absolute;top:0;left:0;width:3px;height:100%;border-radius:3px 0 0 3px;}
.card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.35);}
.ctop{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;gap:5px;}
.ccodes{display:flex;gap:4px;flex-wrap:wrap;flex:1;}
.bm{font-family:‘DM Mono’,monospace;font-size:10px;letter-spacing:1px;padding:2px 7px;border-radius:4px;}
.bu{font-family:‘DM Mono’,monospace;font-size:10px;letter-spacing:.8px;padding:2px 8px;border-radius:4px;background:rgba(91,141,247,.1);color:var(–acc);border:1px solid var(–acc);}
.cacts{display:flex;gap:2px;flex-shrink:0;}
.cbt{background:none;border:none;cursor:pointer;padding:3px 5px;border-radius:4px;font-size:13px;transition:background .15s;}
.cbt:hover{background:var(–sur2);}
.ctitle{font-family:‘Syne’,sans-serif;font-size:14px;font-weight:700;margin-bottom:6px;line-height:1.3;}
.cloc{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:6px;}
.cl{font-size:11px;padding:2px 8px;border-radius:5px;}
.cl-c{background:rgba(91,141,247,.12);color:var(–acc);}
.cl-i{background:rgba(240,192,96,.12);color:var(–gold);}
.mt{font-size:11px;color:var(–mut);background:var(–sur2);border-radius:4px;padding:2px 6px;}
.cdesc{font-size:12px;color:var(–mut);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}

/* CLASSEURS */
.cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;}
.clcard{background:var(–sur);border:1px solid var(–bdr);border-radius:12px;overflow:hidden;}
.clhdr{padding:12px 14px;display:flex;align-items:center;gap:9px;border-bottom:1px solid var(–bdr);cursor:pointer;transition:background .15s;}
.clhdr:hover{background:var(–sur2);}
.clico{width:32px;height:32px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.clinfo{flex:1;}
.clname{font-family:‘Syne’,sans-serif;font-size:14px;font-weight:700;}
.clsub{font-size:11px;color:var(–mut);margin-top:2px;}
.cltog{color:var(–mut);font-size:11px;transition:transform .2s;}
.cltog.open{transform:rotate(180deg);}
.ilist{padding:6px 8px 10px;display:none;}
.ilist.open{display:block;}
.irow{display:flex;align-items:center;gap:6px;padding:5px 7px;border-radius:7px;cursor:pointer;transition:background .15s;}
.irow:hover{background:var(–sur2);}
.inum{width:24px;height:19px;background:var(–sur3);border-radius:4px;font-family:‘DM Mono’,monospace;font-size:10px;display:flex;align-items:center;justify-content:center;color:var(–gold);flex-shrink:0;}
.ilbl{font-size:12px;flex:1;}
.icnt{font-size:11px;color:var(–mut);font-family:‘DM Mono’,monospace;}
.iitems{padding-left:30px;margin-top:2px;}
.iitem{font-size:11px;color:var(–mut);padding:1px 0;font-family:‘DM Mono’,monospace;}

/* MATIÈRES MGT */
.cmgmt{display:flex;flex-direction:column;gap:7px;}
.crow{display:flex;align-items:center;gap:8px;background:var(–sur2);border:1px solid var(–bdr);border-radius:8px;padding:9px 12px;}
.cdot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.clbl{font-family:‘Syne’,sans-serif;font-weight:700;font-size:13px;}
.cname{color:var(–mut);font-size:12px;flex:1;}
.ccnt{color:var(–mut);font-size:11px;font-family:‘DM Mono’,monospace;}
.cdel{background:none;border:none;cursor:pointer;color:var(–red);font-size:14px;padding:2px;}
.nrow{display:flex;gap:6px;align-items:center;margin-top:8px;flex-wrap:wrap;}
.sws{display:flex;gap:4px;flex-wrap:wrap;}
.sw{width:20px;height:20px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:transform .15s,border-color .15s;flex-shrink:0;}
.sw.on,.sw:hover{transform:scale(1.25);border-color:#fff;}
.sttl{font-family:‘Syne’,sans-serif;font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(–mut);margin:16px 0 8px;}

/* MODAL */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(5px);z-index:300;display:flex;align-items:center;justify-content:center;padding:14px;}
.modal{background:var(–sur);border:1px solid var(–bdr);border-radius:16px;padding:20px;width:100%;max-width:410px;max-height:92vh;overflow-y:auto;}
.modal h2{font-family:‘Syne’,sans-serif;font-size:16px;font-weight:800;margin-bottom:14px;}
.fg{margin-bottom:11px;}
.fg label{display:block;font-size:11px;font-weight:500;color:var(–mut);margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px;}
.fg input,.fg textarea,.fg select{width:100%;background:var(–sur2);border:1px solid var(–bdr);border-radius:8px;padding:8px 11px;color:var(–txt);font-family:‘DM Sans’,sans-serif;font-size:13px;outline:none;transition:border-color .2s;resize:vertical;}
.fg input:focus,.fg textarea:focus,.fg select:focus{border-color:var(–acc);}
.uidbox{background:var(–sur3);border:1px solid var(–bdr);border-radius:8px;padding:10px 12px;font-family:‘DM Mono’,monospace;font-size:15px;letter-spacing:2px;color:var(–acc);text-align:center;margin-bottom:11px;}
.uidbox small{color:var(–mut);font-size:11px;display:block;margin-top:3px;letter-spacing:.4px;font-family:‘DM Sans’,sans-serif;}
.macts{display:flex;gap:7px;margin-top:13px;}
.bp{flex:1;background:var(–acc);border:none;border-radius:8px;padding:10px;color:#fff;font-family:‘Syne’,sans-serif;font-weight:700;font-size:13px;cursor:pointer;transition:opacity .2s;}
.bp:hover{opacity:.85;}
.bs{background:var(–sur2);border:1px solid var(–bdr);border-radius:8px;padding:10px 15px;color:var(–txt);font-family:‘Syne’,sans-serif;font-weight:600;font-size:13px;cursor:pointer;}
.bs:hover{background:var(–bdr);}

/* QR MODAL */
.qrmid{text-align:center;}
.qrmid h2{margin-bottom:4px;}
.qrmid p{color:var(–mut);font-size:12px;margin-bottom:14px;}
#qrWrap{display:inline-block;background:#fff;padding:10px;border-radius:9px;margin-bottom:10px;}
#qrWrap img{display:block;border-radius:5px;}
.qrlbl{font-family:‘DM Mono’,monospace;font-size:13px;letter-spacing:1.5px;color:var(–acc);margin-bottom:13px;}

/* CAMERA */
.camwrap{position:relative;width:100%;max-width:300px;margin:0 auto 11px;border-radius:11px;overflow:hidden;background:#000;aspect-ratio:1;}
#camVideo{width:100%;height:100%;object-fit:cover;display:block;}
.camline{position:absolute;left:10%;right:10%;height:2px;background:var(–acc);box-shadow:0 0 8px var(–acc);animation:scan 2s ease-in-out infinite;}
@keyframes scan{0%,100%{top:25%}50%{top:75%}}
.camst{font-size:12px;color:var(–mut);margin-bottom:10px;min-height:16px;}

/* FAB */
.fab{position:fixed;bottom:20px;right:20px;width:50px;height:50px;border-radius:50%;background:var(–acc);border:none;color:#fff;font-size:22px;cursor:pointer;z-index:200;box-shadow:0 4px 16px rgba(91,141,247,.5);transition:transform .2s;display:flex;align-items:center;justify-content:center;}
.fab:hover{transform:scale(1.1);}

.empty{text-align:center;padding:46px 20px;color:var(–mut);grid-column:1/-1;}
.empty .e{font-size:40px;margin-bottom:12px;}
.empty h3{font-family:‘Syne’,sans-serif;color:var(–txt);margin-bottom:4px;font-size:15px;}
.hidden{display:none!important;}
</style>

</head>
<body>

<header>
  <h1>📚 Mes <span>Cours</span></h1>
  <p>Localisation physique par code unique</p>
</header>

<div class="sbar">
  <span class="slbl">🔎 CODE :</span>
  <div class="swrap">
    <input type="text" id="scanInput" placeholder="PHYSA1001  →  auto-format">
  </div>
  <button class="sbtn sbtn-loc" id="btnLoc">Localiser</button>
  <button class="sbtn sbtn-cam" id="btnCam">📷 Caméra</button>
  <button class="sbtn sbtn-csv" id="btnCsv">⬇ CSV</button>
</div>
<div class="sres hidden" id="scanRes"></div>

<div class="stbar" id="statsBar"></div>

<div class="tabs">
  <button class="tb on" data-tab="cours">📋 Cours</button>
  <button class="tb" data-tab="classeurs">🗂️ Classeurs</button>
  <button class="tb" data-tab="codes">🏷️ Matières</button>
</div>

<div class="pane" id="paneCours">
  <div class="frow">
    <input class="fi fgrow" type="text" id="searchInput" placeholder="🔍 Titre, code, matière...">
    <select class="fi" id="filterMat" style="flex:1;min-width:100px"></select>
    <select class="fi" id="filterCl" style="flex:1;min-width:100px"></select>
  </div>
  <div class="chips" id="chips"></div>
  <div class="grid" id="coursGrid"></div>
</div>

<div class="pane hidden" id="paneClasseurs">
  <p style="color:var(--mut);font-size:13px;margin-bottom:12px">Clique sur un classeur pour voir ses 12 intercalaires.</p>
  <div class="cgrid" id="classeursGrid"></div>
</div>

<div class="pane hidden" id="paneCodes">
  <div class="cmgmt" id="codesMgmt"></div>
</div>

<button class="fab" id="fabAdd" title="Ajouter un cours">＋</button>

<!-- MODAL COURS -->

<div class="ov hidden" id="ovCours">
  <div class="modal">
    <h2 id="mTitle">✏️ Ajouter un cours</h2>
    <div class="fg"><label>Titre *</label><input type="text" id="fTitle" placeholder="ex: Chapitre 3 — Cinématique"></div>
    <div class="fg"><label>Matière *</label><select id="fMat"></select></div>
    <div class="fg"><label>Classeur *</label><select id="fCl"></select></div>
    <div class="fg">
      <label>Intercalaire (1–12) *</label>
      <select id="fInter">
        <option value="">— Choisir —</option>
        <option value="1">1 — Intro</option><option value="2">2 — Cours 1</option>
        <option value="3">3 — Cours 2</option><option value="4">4 — Cours 3</option>
        <option value="5">5 — Cours 4</option><option value="6">6 — Cours 5</option>
        <option value="7">7 — Exercices</option><option value="8">8 — TD</option>
        <option value="9">9 — TP</option><option value="10">10 — Fiches</option>
        <option value="11">11 — Annales</option><option value="12">12 — Divers</option>
      </select>
    </div>
    <div class="uidbox" id="uidBox">—<small>Code unique généré automatiquement</small></div>
    <div class="fg"><label>Description / Notes</label><textarea id="fDesc" rows="2" placeholder="Résumé, remarques..."></textarea></div>
    <div class="fg"><label>Date</label><input type="date" id="fDate"></div>
    <div class="macts">
      <button class="bs" id="btnCancel">Annuler</button>
      <button class="bp" id="btnSave">💾 Enregistrer</button>
    </div>
  </div>
</div>

<!-- MODAL QR -->

<div class="ov hidden" id="ovQR">
  <div class="modal qrmid">
    <h2 id="qrTitle">📱 QR Code</h2>
    <p id="qrSub"></p>
    <div id="qrWrap"></div>
    <div class="qrlbl" id="qrLbl"></div>
    <div class="macts" style="justify-content:center">
      <button class="bs" id="btnDlQR">⬇ Télécharger</button>
      <button class="bs" id="btnCloseQR">Fermer</button>
    </div>
  </div>
</div>

<!-- MODAL CAM -->

<div class="ov hidden" id="ovCam">
  <div class="modal qrmid">
    <h2>📷 Scanner QR Code</h2>
    <p>Pointe la caméra vers le QR code imprimé sur ton cours</p>
    <div class="camwrap">
      <video id="camVideo" autoplay playsinline muted></video>
      <div class="camline"></div>
    </div>
    <canvas id="camCanvas" style="display:none"></canvas>
    <div class="camst" id="camSt">Initialisation...</div>
    <div class="macts" style="justify-content:center">
      <button class="bs" id="btnStopCam">✕ Fermer</button>
    </div>
  </div>
</div>

<script>
(function(){
'use strict';

// ─── CONSTANTS ───
const SEP = '\u00b7'; // · middle dot
const IN = ['','Intro','Cours 1','Cours 2','Cours 3','Cours 4','Cours 5','Exercices','TD','TP','Fiches','Annales','Divers'];
const COLORS = ['#5b8df7','#f0c060','#50d890','#f06060','#b06af7','#f06ab0','#60d0f0','#f09060'];

// ─── STATE ───
let D = JSON.parse(localStorage.getItem('mc_v6') || 'null') || {
  matieres:[
    {id:'PHYS',label:'PHYS',name:'Physique',color:'#5b8df7'},
    {id:'MATH',label:'MATH',name:'Math\u00e9matiques',color:'#f0c060'},
    {id:'CHIM',label:'CHIM',name:'Chimie',color:'#50d890'},
  ],
  classeurs:[
    {id:'A',name:'Classeur Physique A',icon:'\ud83d\udcd8',color:'#5b8df7'},
    {id:'B',name:'Classeur Physique B',icon:'\ud83d\udcd7',color:'#b06af7'},
    {id:'C',name:'Classeur Maths',icon:'\ud83d\udcd9',color:'#f0c060'},
  ],
  cours:[
    {uid:'PHYS\u00b7A\u00b71\u00b7001',title:'Les lois de Newton',mat:'PHYS',cl:'A',inter:1,desc:'Inertie, F=ma, action-r\u00e9action',date:'2025-03-10'},
    {uid:'MATH\u00b7C\u00b72\u00b7001',title:'D\u00e9riv\u00e9es et int\u00e9grales',mat:'MATH',cl:'C',inter:2,desc:'R\u00e8gles de d\u00e9rivation, primitives',date:'2025-03-12'},
    {uid:'CHIM\u00b7A\u00b73\u00b7001',title:'Liaison covalente',mat:'CHIM',cl:'A',inter:3,desc:"Partage d'\u00e9lectrons, polarit\u00e9",date:'2025-03-15'},
    {uid:'PHYS\u00b7B\u00b71\u00b7001',title:'Optique g\u00e9om\u00e9trique',mat:'PHYS',cl:'B',inter:1,desc:'R\u00e9flexion, r\u00e9fraction, lentilles',date:'2025-03-18'},
  ]
};

let editUid = null;
let chipFilter = null;
let newColor = COLORS[0];
let curQRUid = null;
let camStream = null;
let camTick = null;

const save = () => localStorage.setItem('mc_v6', JSON.stringify(D));
const $ = id => document.getElementById(id);
const fmtD = d => { if(!d) return ''; const[y,m,j]=d.split('-'); return j+'/'+m+'/'+y; };

// ─── AUTO-FORMAT SCANNER ───
function autoFmt() {
  const el = $('scanInput');
  const raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
  let i=0, s1='', s2='', s3='', s4='';
  while(i<raw.length && /[A-Z]/.test(raw[i]) && s1.length<6) s1+=raw[i++];
  while(i<raw.length && /[A-Z]/.test(raw[i]) && s2.length<2) s2+=raw[i++];
  while(i<raw.length && /[0-9]/.test(raw[i]) && s3.length<2) s3+=raw[i++];
  while(i<raw.length && /[0-9]/.test(raw[i]) && s4.length<3) s4+=raw[i++];
  const parts = [s1];
  if(s2) parts.push(s2);
  if(s3) parts.push(s3);
  if(s4) parts.push(s4);
  const res = parts.join(SEP);
  if(el.value !== res) { el.value = res; el.selectionStart = el.selectionEnd = res.length; }
  if(!res) hideScanRes();
}

// ─── SCANNER ───
function doScan() {
  const raw = $('scanInput').value.trim().toUpperCase().replace(/[^A-Z0-9\u00b7]/g,'');
  const el = $('scanRes');
  const c = D.cours.find(x => x.uid === raw);
  if(c) {
    const mo = D.matieres.find(m=>m.id===c.mat) || {name:c.mat,color:'#5b8df7'};
    const co = D.classeurs.find(x=>x.id===c.cl) || {name:c.cl,icon:'\ud83d\udcc1'};
    el.className = 'sres found';
    el.innerHTML =
      '<div class="rcode">'+c.uid+'</div>'+
      '<div class="rloc">'+
        '<span class="lb lb-cl">'+co.icon+' '+co.name+'</span>'+
        '<span class="lb lb-in">\ud83d\udcd1 Intercalaire '+c.inter+' \u2014 '+(IN[c.inter]||'')+'</span>'+
        '<span class="lb lb-nu">\ud83d\udcc4 N\u00b0 '+c.uid.split(SEP)[3]+'</span>'+
      '</div>'+
      '<div class="rtitle">'+c.title+'</div>'+
      '<div class="rsub">'+mo.name+(c.date?' \u00b7 '+fmtD(c.date):'')+(c.desc?' \u2014 '+c.desc:'')+'</div>';
    el.classList.remove('hidden');
  } else if(raw.length > 2) {
    el.className = 'sres notfound';
    el.innerHTML = '<div style="color:var(--red);font-family:\'DM Mono\',monospace;margin-bottom:5px">\u274c Code introuvable : '+raw+'</div>'+
      '<div style="color:var(--mut);font-size:12px">Format : MATI\u00c8RE\u00b7CLASSEUR\u00b7INTER\u00b7NNN \u2014 ex: <strong style="color:var(--acc)">PHYS\u00b7A\u00b71\u00b7001</strong></div>';
    el.classList.remove('hidden');
  } else {
    hideScanRes();
  }
}
function hideScanRes() { $('scanRes').classList.add('hidden'); }

// ─── CSV ───
function exportCSV() {
  const hdr = ['Code','Titre','Matiere','Classeur','Intercalaire','Section','Description','Date'];
  const esc = v => '"'+String(v||'').replace(/"/g,'""')+'"';
  const rows = D.cours.map(c => {
    const mo = D.matieres.find(m=>m.id===c.mat)||{name:c.mat};
    const co = D.classeurs.find(x=>x.id===c.cl)||{name:c.cl};
    return [c.uid,c.title,mo.name,co.name,c.inter,IN[c.inter]||'',c.desc||'',c.date||''].map(esc).join(',');
  });
  const csv = [hdr.join(','),...rows].join('\n');
  const blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download='mes-cours-'+new Date().toISOString().split('T')[0]+'.csv'; a.click();
  URL.revokeObjectURL(url);
}

// ─── QR CODE ───
function showQR(uid) {
  const c = D.cours.find(x=>x.uid===uid); if(!c) return;
  curQRUid = uid;
  const mo = D.matieres.find(m=>m.id===c.mat)||{name:c.mat};
  const co = D.classeurs.find(x=>x.id===c.cl)||{name:c.cl};
  $('qrTitle').textContent = '\ud83d\udcf1 '+c.title;
  $('qrSub').textContent = mo.name+' \u00b7 '+co.name+' \u00b7 Intercalaire '+c.inter+' \u00b7 '+(IN[c.inter]||'');
  $('qrLbl').textContent = uid;
  const size = 200;
  const url = 'https://api.qrserver.com/v1/create-qr-code/?size='+size+'x'+size+'&data='+encodeURIComponent(uid);
  $('qrWrap').innerHTML = '<img id="qrImg" src="'+url+'" width="'+size+'" height="'+size+'" alt="QR Code" style="border-radius:5px;display:block;">';
  $('ovQR').classList.remove('hidden');
}
function closeQR() { $('ovQR').classList.add('hidden'); curQRUid=null; }
function dlQR() {
  if(!curQRUid) return;
  const img = document.getElementById('qrImg');
  if(!img) return;
  const cv = document.createElement('canvas');
  cv.width=240; cv.height=270;
  const ctx = cv.getContext('2d');
  ctx.fillStyle='#fff'; ctx.fillRect(0,0,240,270);
  try {
    ctx.drawImage(img,20,20,200,200);
    ctx.fillStyle='#000'; ctx.font='bold 11px monospace'; ctx.textAlign='center';
    ctx.fillText(curQRUid,120,238);
    const a=document.createElement('a');
    a.download='qr-'+curQRUid.replace(/\u00b7/g,'-')+'.png';
    a.href=cv.toDataURL('image/png'); a.click();
  } catch(e) { window.open(img.src); }
}

// ─── CAMERA ───
function openCam() {
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia) {
    alert('La cam\u00e9ra n\'est pas disponible. Utilise Chrome sur t\u00e9l\u00e9phone.'); return;
  }
  $('ovCam').classList.remove('hidden');
  $('camSt').textContent = 'Demande d\'acc\u00e8s \u00e0 la cam\u00e9ra...';
  navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:640},height:{ideal:640}}})
    .then(stream => {
      camStream = stream;
      const v = $('camVideo');
      v.srcObject = stream; v.play();
      $('camSt').textContent = '\ud83d\udd0d Recherche d\'un QR code...';
      function loadJsQR() {
        if(window.jsQR) { camTick = setInterval(()=>scanFrame(v),250); return; }
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js';
        s.onload = () => { camTick = setInterval(()=>scanFrame(v),250); };
        s.onerror = () => { $('camSt').textContent = '\u274c jsQR non charg\u00e9 (hors-ligne?)'; };
        document.head.appendChild(s);
      }
      loadJsQR();
    })
    .catch(err => { $('camSt').textContent = '\u274c Cam\u00e9ra refus\u00e9e : '+err.message; });
}
function scanFrame(video) {
  if(video.readyState!==4||!window.jsQR) return;
  const cv = $('camCanvas');
  cv.width=video.videoWidth; cv.height=video.videoHeight;
  const ctx = cv.getContext('2d');
  ctx.drawImage(video,0,0);
  const d = ctx.getImageData(0,0,cv.width,cv.height);
  const code = jsQR(d.data,d.width,d.height,{inversionAttempts:'dontInvert'});
  if(code&&code.data) {
    const uid = code.data.trim().toUpperCase();
    if(D.cours.find(c=>c.uid===uid)) {
      stopCam();
      $('scanInput').value = uid;
      doScan();
      window.scrollTo({top:0,behavior:'smooth'});
    } else {
      $('camSt').textContent = '\u26a0 Lu: '+uid+' (inconnu)';
    }
  }
}
function stopCam() {
  if(camTick){clearInterval(camTick);camTick=null;}
  if(camStream){camStream.getTracks().forEach(t=>t.stop());camStream=null;}
  const v=$('camVideo'); if(v) v.srcObject=null;
  $('ovCam').classList.add('hidden');
  $('camSt').textContent='Initialisation...';
}

// ─── UID ───
function genUid(mat,cl,inter) {
  const n = D.cours.filter(c=>{const p=c.uid.split(SEP);return p[0]===mat&&p[1]===cl&&p[2]===String(inter);}).length+1;
  return mat+SEP+cl+SEP+inter+SEP+String(n).padStart(3,'0');
}
function updateUid() {
  const mat=$('fMat').value, cl=$('fCl').value, inter=$('fInter').value;
  const box=$('uidBox');
  if(mat&&cl&&inter) {
    const uid = editUid||genUid(mat,cl,inter);
    box.innerHTML = uid+'<small>Code unique de localisation physique</small>';
  } else {
    box.innerHTML = '\u2014<small>S\u00e9lectionne mati\u00e8re + classeur + intercalaire</small>';
  }
}

// ─── TABS ───
function switchTab(tab) {
  document.querySelectorAll('.tb').forEach(b => b.classList.toggle('on', b.dataset.tab===tab));
  ['cours','classeurs','codes'].forEach(t => {
    const id = 'pane'+t.charAt(0).toUpperCase()+t.slice(1);
    document.getElementById(id).classList.toggle('hidden', t!==tab);
  });
  if(tab==='classeurs') renderClasseurs();
  if(tab==='codes') renderCodes();
}

// ─── STATS ───
function renderStats() {
  $('statsBar').innerHTML =
    '<div class="sc"><span class="dot" style="background:#5b8df7"></span>'+D.cours.length+' cours</div>'+
    '<div class="sc"><span class="dot" style="background:#50d890"></span>'+D.classeurs.length+' classeurs</div>'+
    D.matieres.map(m=>'<div class="sc"><span class="dot" style="background:'+m.color+'"></span>'+m.label+': '+D.cours.filter(c=>c.mat===m.id).length+'</div>').join('');
}

// ─── COURS ───
function renderCours() {
  const allM = [...new Set(D.cours.map(c=>c.mat))];
  const allC = [...new Set(D.cours.map(c=>c.cl))];
  const ms=$('filterMat'), cs=$('filterCl');
  const mv=ms.value, cv=cs.value;
  ms.innerHTML = '<option value="">Toutes les mati\u00e8res</option>'+
    allM.map(m=>{const mo=D.matieres.find(x=>x.id===m)||{name:m};return'<option value="'+m+'"'+(m===mv?' selected':'')+'>'+mo.name+'</option>';}).join('');
  cs.innerHTML = '<option value="">Tous les classeurs</option>'+
    allC.map(c=>{const co=D.classeurs.find(x=>x.id===c)||{name:c};return'<option value="'+c+'"'+(c===cv?' selected':'')+'>'+co.name+'</option>';}).join('');

  // Chips
  const chipsEl = $('chips');
  chipsEl.innerHTML = '<button class="chip'+(chipFilter===null?' on':'')+'" data-chip="null">Tous</button>'+
    D.matieres.map(m=>'<button class="chip'+(chipFilter===m.id?' on':'')+'" data-chip="'+m.id+'" style="'+(chipFilter===m.id?'background:'+m.color+';border-color:'+m.color:'border-color:'+m.color+'60;color:'+m.color)+'">'+ m.label+'</button>').join('');
  chipsEl.querySelectorAll('.chip').forEach(btn => {
    btn.addEventListener('click', () => {
      chipFilter = btn.dataset.chip==='null' ? null : btn.dataset.chip;
      renderCours();
    });
  });

  const q=$('searchInput').value.toLowerCase();
  const list = D.cours.filter(c=>{
    const mo=D.matieres.find(x=>x.id===c.mat)||{name:''};
    return (!q||c.title.toLowerCase().includes(q)||c.uid.toLowerCase().includes(q)||mo.name.toLowerCase().includes(q)||(c.desc||'').toLowerCase().includes(q))
      &&(!ms.value||c.mat===ms.value)&&(!cs.value||c.cl===cs.value)&&(!chipFilter||c.mat===chipFilter);
  });

  const grid = $('coursGrid');
  if(!list.length) {
    grid.innerHTML='<div class="empty"><div class="e">\ud83d\udced</div><h3>Aucun cours trouv\u00e9</h3><p>Modifie les filtres ou clique sur + pour ajouter.</p></div>';
    renderStats(); return;
  }
  grid.innerHTML = list.map(c=>{
    const mo=D.matieres.find(x=>x.id===c.mat)||{color:'#6a6a88',label:c.mat,name:c.mat};
    const co=D.classeurs.find(x=>x.id===c.cl)||{name:c.cl,icon:'\ud83d\udcc1'};
    return '<div class="card" style="--cc:'+mo.color+'" data-uid="'+c.uid+'">'+
      '<div class="ctop">'+
        '<div class="ccodes">'+
          '<span class="bm" style="background:'+mo.color+'20;color:'+mo.color+';border:1px solid '+mo.color+'">'+mo.label+'</span>'+
          '<span class="bu">'+c.uid+'</span>'+
        '</div>'+
        '<div class="cacts">'+
          '<button class="cbt" data-action="qr" data-uid="'+c.uid+'" title="QR Code">\u25a3</button>'+
          '<button class="cbt" data-action="edit" data-uid="'+c.uid+'">\u270f\ufe0f</button>'+
          '<button class="cbt" data-action="del" data-uid="'+c.uid+'">\ud83d\uddd1\ufe0f</button>'+
        '</div>'+
      '</div>'+
      '<div class="ctitle">'+c.title+'</div>'+
      '<div class="cloc">'+
        '<span class="cl cl-c">'+co.icon+' '+co.name+'</span>'+
        '<span class="cl cl-i">\ud83d\udcd1 Inter.'+c.inter+' \u00b7 '+(IN[c.inter]||'')+'</span>'+
      '</div>'+
      (c.date?'<div style="margin-bottom:5px"><span class="mt">\ud83d\udcc5 '+fmtD(c.date)+'</span></div>':'')+
      (c.desc?'<div class="cdesc">'+c.desc+'</div>':'')+
    '</div>';
  }).join('');

  // Attach card button events
  grid.querySelectorAll('.cbt').forEach(btn=>{
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const uid = btn.dataset.uid;
      if(btn.dataset.action==='qr') showQR(uid);
      else if(btn.dataset.action==='edit') editCours(uid);
      else if(btn.dataset.action==='del') delCours(uid);
    });
  });
  // Apply card border color
  grid.querySelectorAll('.card').forEach(card=>{
    const mo=D.matieres.find(x=>x.id===D.cours.find(c=>c.uid===card.dataset.uid)?.mat)||{color:'#5b8df7'};
    card.style.borderColor='';
    card.querySelector('.card::before');
    card.style.setProperty('--cc',mo.color);
    card.style.borderLeft='3px solid '+mo.color;
  });

  renderStats();
}

function delCours(uid) {
  if(!confirm('Supprimer '+uid+' ?')) return;
  D.cours = D.cours.filter(c=>c.uid!==uid);
  save(); renderCours();
}
function editCours(uid) {
  const c=D.cours.find(x=>x.uid===uid); if(!c) return;
  editUid=uid;
  $('mTitle').textContent='\u270f\ufe0f Modifier le cours';
  $('fTitle').value=c.title;
  $('fDesc').value=c.desc||'';
  $('fDate').value=c.date||'';
  popSel(c.mat,c.cl,String(c.inter));
  $('uidBox').innerHTML=c.uid+'<small>Code unique de localisation physique</small>';
  $('ovCours').classList.remove('hidden');
}

// ─── CLASSEURS ───
function renderClasseurs() {
  const g=$('classeursGrid');
  if(!D.classeurs.length){g.innerHTML='<div class="empty"><div class="e">\ud83d\uddc2\ufe0f</div><h3>Aucun classeur</h3></div>';return;}
  g.innerHTML = D.classeurs.map(cl=>{
    const cc=D.cours.filter(c=>c.cl===cl.id);
    return '<div class="clcard">'+
      '<div class="clhdr" data-cl="'+cl.id+'">'+
        '<div class="clico" style="background:'+cl.color+'20">'+cl.icon+'</div>'+
        '<div class="clinfo"><div class="clname">'+cl.name+'</div><div class="clsub">'+cc.length+' cours \u00b7 ID : '+cl.id+'</div></div>'+
        '<div class="cltog" id="tog_'+cl.id+'">\u25bc</div>'+
      '</div>'+
      '<div class="ilist" id="ili_'+cl.id+'">'+
        Array.from({length:12},(_,i)=>i+1).map(n=>{
          const items=cc.filter(c=>c.inter===n);
          return '<div class="irow" data-cl="'+cl.id+'" data-n="'+n+'">'+
            '<div class="inum">'+n+'</div>'+
            '<div class="ilbl">'+IN[n]+'</div>'+
            '<div class="icnt">'+(items.length?items.length+' cours':'\u2014')+'</div>'+
          '</div>'+
          (items.length?'<div class="iitems">'+items.map(x=>'<div class="iitem">'+x.uid+' <span style="color:var(--txt);font-family:\'DM Sans\',sans-serif">\u2014 '+x.title+'</span></div>').join('')+'</div>':'');
        }).join('')+
      '</div>'+
    '</div>';
  }).join('');

  g.querySelectorAll('.clhdr').forEach(hdr=>{
    hdr.addEventListener('click',()=>{
      const id=hdr.dataset.cl;
      document.getElementById('ili_'+id).classList.toggle('open');
      document.getElementById('tog_'+id).classList.toggle('open');
    });
  });
  g.querySelectorAll('.irow').forEach(row=>{
    row.addEventListener('click',()=>{
      switchTab('cours');
      $('filterCl').value=row.dataset.cl;
      chipFilter=null; renderCours();
      window.scrollTo({top:0,behavior:'smooth'});
    });
  });
}

// ─── MATIÈRES ───
function renderCodes() {
  const el=$('codesMgmt');
  el.innerHTML =
    '<p class="sttl" style="margin-top:0">Mati\u00e8res</p>'+
    D.matieres.map(m=>
      '<div class="crow">'+
        '<div class="cdot" style="background:'+m.color+'"></div>'+
        '<div class="clbl">'+m.label+'</div>'+
        '<div class="cname">'+m.name+'</div>'+
        '<div class="ccnt">'+D.cours.filter(c=>c.mat===m.id).length+' cours</div>'+
        '<button class="cdel" data-id="'+m.id+'" data-type="mat">\u2715</button>'+
      '</div>'
    ).join('')+
    '<div class="nrow">'+
      '<input class="fi" type="text" id="nMlbl" placeholder="Pr\u00e9fixe" style="width:80px">'+
      '<input class="fi fgrow" type="text" id="nMname" placeholder="Nom complet">'+
      '<div class="sws" id="swMat"></div>'+
      '<button class="bp" id="btnAddMat" style="flex:0;padding:8px 12px;border-radius:8px;font-size:12px">\ufe0f\u208a</button>'+
    '</div>'+
    '<p class="sttl">Classeurs</p>'+
    D.classeurs.map(cl=>
      '<div class="crow">'+
        '<div style="font-size:14px">'+cl.icon+'</div>'+
        '<div class="clbl">['+cl.id+']</div>'+
        '<div class="cname">'+cl.name+'</div>'+
        '<div class="ccnt">'+D.cours.filter(c=>c.cl===cl.id).length+' cours</div>'+
        '<button class="cdel" data-id="'+cl.id+'" data-type="cl">\u2715</button>'+
      '</div>'
    ).join('')+
    '<div class="nrow">'+
      '<input class="fi" type="text" id="nClId" placeholder="ID" style="width:50px">'+
      '<input class="fi fgrow" type="text" id="nClNm" placeholder="Nom du classeur">'+
      '<input class="fi" type="text" id="nClIc" placeholder="\ud83d\udcd2" style="width:44px">'+
      '<button class="bp" id="btnAddCl" style="flex:0;padding:8px 12px;border-radius:8px;font-size:12px">\ufe0f\u208a</button>'+
    '</div>';

  // Color swatches
  $('swMat').innerHTML = COLORS.map(c=>
    '<div class="sw'+(c===newColor?' on':'')+'" style="background:'+c+'" data-col="'+c+'"></div>'
  ).join('');
  $('swMat').querySelectorAll('.sw').forEach(sw=>{
    sw.addEventListener('click',()=>{ newColor=sw.dataset.col; renderCodes(); });
  });

  el.querySelectorAll('.cdel').forEach(btn=>{
    btn.addEventListener('click',()=>{
      if(btn.dataset.type==='mat') delMat(btn.dataset.id);
      else delCl(btn.dataset.id);
    });
  });
  $('btnAddMat').addEventListener('click', addMat);
  $('btnAddCl').addEventListener('click', addCl);
}

function addMat() {
  const lbl=$('nMlbl').value.trim().toUpperCase();
  const name=$('nMname').value.trim();
  if(!lbl){alert('Entre un pr\u00e9fixe !');return;}
  if(D.matieres.find(m=>m.id===lbl)){alert('Ce pr\u00e9fixe existe d\u00e9j\u00e0 !');return;}
  D.matieres.push({id:lbl,label:lbl,name:name||lbl,color:newColor});
  save(); renderCodes(); renderCours();
}
function delMat(id) {
  if(D.cours.filter(c=>c.mat===id).length&&!confirm('Des cours utilisent cette mati\u00e8re. Continuer ?')) return;
  D.matieres=D.matieres.filter(m=>m.id!==id); save(); renderCodes(); renderCours();
}
function addCl() {
  const id=$('nClId').value.trim().toUpperCase();
  const name=$('nClNm').value.trim();
  const icon=$('nClIc').value.trim()||'\ud83d\udcc1';
  if(!id||!name){alert('ID et nom obligatoires !');return;}
  if(D.classeurs.find(c=>c.id===id)){alert('Cet ID existe d\u00e9j\u00e0 !');return;}
  D.classeurs.push({id,name,icon,color:newColor}); save(); renderCodes(); renderCours();
}
function delCl(id) {
  if(D.cours.filter(c=>c.cl===id).length&&!confirm('Des cours sont dans ce classeur. Continuer ?')) return;
  D.classeurs=D.classeurs.filter(c=>c.id!==id); save(); renderCodes(); renderCours();
}

// ─── MODAL COURS ───
function openModal() {
  editUid=null;
  $('mTitle').textContent='\u270f\ufe0f Ajouter un cours';
  $('fTitle').value=''; $('fDesc').value='';
  $('fDate').value=new Date().toISOString().split('T')[0];
  popSel('','','');
  $('uidBox').innerHTML='\u2014<small>S\u00e9lectionne mati\u00e8re + classeur + intercalaire</small>';
  $('ovCours').classList.remove('hidden');
}
function closeModal() { $('ovCours').classList.add('hidden'); }
function popSel(mat,cl,inter) {
  $('fMat').innerHTML=D.matieres.map(m=>'<option value="'+m.id+'"'+(m.id===mat?' selected':'')+'>'+m.label+' \u2014 '+m.name+'</option>').join('');
  $('fCl').innerHTML='<option value="">\u2014 Choisir classeur \u2014</option>'+
    D.classeurs.map(c=>'<option value="'+c.id+'"'+(c.id===cl?' selected':'')+'>'+c.icon+' '+c.name+'</option>').join('');
  $('fInter').value=inter||''; updateUid();
}
function saveCours() {
  const title=$('fTitle').value.trim();
  const mat=$('fMat').value, cl=$('fCl').value, inter=parseInt($('fInter').value);
  if(!title){alert('Titre obligatoire !');return;}
  if(!cl){alert('Choisis un classeur !');return;}
  if(!inter){alert('Choisis un intercalaire !');return;}
  const obj={title,mat,cl,inter,desc:$('fDesc').value.trim(),date:$('fDate').value};
  if(editUid){ const idx=D.cours.findIndex(c=>c.uid===editUid); D.cours[idx]={...D.cours[idx],...obj}; }
  else { obj.uid=genUid(mat,cl,inter); D.cours.unshift(obj); }
  save(); closeModal(); renderCours();
}

// ─── EVENTS ───
$('scanInput').addEventListener('input', autoFmt);
$('scanInput').addEventListener('keydown', e=>{ if(e.key==='Enter') doScan(); });
$('btnLoc').addEventListener('click', doScan);
$('btnCam').addEventListener('click', openCam);
$('btnCsv').addEventListener('click', exportCSV);
$('fabAdd').addEventListener('click', openModal);
$('btnCancel').addEventListener('click', closeModal);
$('btnSave').addEventListener('click', saveCours);
$('btnCloseQR').addEventListener('click', closeQR);
$('btnDlQR').addEventListener('click', dlQR);
$('btnStopCam').addEventListener('click', stopCam);
$('fMat').addEventListener('change', updateUid);
$('fCl').addEventListener('change', updateUid);
$('fInter').addEventListener('change', updateUid);
$('fTitle').addEventListener('input', updateUid);
$('searchInput').addEventListener('input', renderCours);
$('filterMat').addEventListener('change', renderCours);
$('filterCl').addEventListener('change', renderCours);
document.querySelectorAll('.tb').forEach(btn=>{
  btn.addEventListener('click', ()=>switchTab(btn.dataset.tab));
});

// ─── INIT ───
renderCours();

})();
</script>

