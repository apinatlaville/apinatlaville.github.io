  <div class="fc-grid" id="fcGrid"></div>
</div>

<div class="pane" id="panePrint">
  <div class="pbar">
    <div>
      <h3 style="font-family:'Syne';font-size:16px;margin-bottom:4px">Étiquettes QR</h3>
