    <div class="macts">
      <button class="bs" id="btnCancelCours">Annuler</button>
      <button class="bp" onclick="window.saveCours()" id="btnSaveCours">Enregistrer</button>
    </div>
  </div>
</div>

<div class="ov hidden" id="ovQR">
