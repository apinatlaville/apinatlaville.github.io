  <h3 style="font-family:'Syne'; margin-bottom:15px; color:var(--txt); font-size:15px;">Profil & Accueil</h3>
  <div class="set-row">
    <div><div class="set-lbl">Ton Prénom</div><div class="set-sub">Affiché sur l'écran d'accueil</div></div>
    <input type="text" id="setUserName" placeholder="Prénom" style="width:120px; background:var(--s3); border:1px solid var(--bd); color:var(--txt); padding:8px; border-radius:8px; outline:none; text-align:center;">
  </div>
  <div class="set-row"><div><div class="set-lbl">Recherche Accueil</div><div class="set-sub">Gros bloc de recherche</div></div><button class="toggle-btn" id="btnDashHeroToggle">Oui</button></div>
  <div class="set-row"><div><div class="set-lbl">Statut des révisions</div><div class="set-sub">Feux tricolores (Accueil)</div></div><button class="toggle-btn" id="btnDashRevToggle">Oui</button></div>
  <div class="set-row"><div><div class="set-lbl">Vue d'ensemble</div><div class="set-sub">Comptage (Accueil)</div></div><button class="toggle-btn" id="btnDashOverToggle">Oui</button></div>

