}

function closeLocPopup() {
  $('locPopup').classList.remove('open');
}

// ══════════════════════════════════════════════
// TABS
// ══════════════════════════════════════════════
function switchTab(tab) {
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b.dataset.tab === tab));
  const map = {cours:'paneCours', print:'panePrint', classeurs:'paneClasseurs', matieres:'paneMatieres'};
  Object.values(map).forEach(id => { document.getElementById(id).classList.remove('on'); document.getElementById(id).classList.add('hidden'); });
  document.getElementById(map[tab]).classList.remove('hidden');
  document.getElementById(map[tab]).classList.add('on');
  if (tab === 'print') renderPrintGrid();
  if (tab === 'classeurs') renderClasseurs();
  if (tab === 'matieres') renderMatieres();
}

// ══════════════════════════════════════════════
// STATS
// ══════════════════════════════════════════════
function renderStats() {
  const pending = D.cours.filter(c => !c.qrPrinted).length;
  $('statsBand').innerHTML =
    '<div class="stc"><span class="dot" style="background:#5b8df7"></span>' + D.cours.length + ' cours</div>' +
    '<div class="stc"><span class="dot" style="background:#50d890"></span>' + D.classeurs.length + ' classeurs</div>' +
    (pending ? '<div class="stc"><span class="dot" style="background:#f0c060"></span>' + pending + ' QR \u00e0 imprimer</div>' : '') +
    D.matieres.map(m => '<div class="stc"><span class="dot" style="background:' + m.color + '"></span>' + m.label + ': ' + D.cours.filter(c => c.mat === m.id).length + '</div>').join('');
}

// ══════════════════════════════════════════════
// COURS
// ══════════════════════════════════════════════
function renderCours() {
  const allM = [...new Set(D.cours.map(c => c.mat))];
  const allC = [...new Set(D.cours.map(c => c.cl))];
  const ms = $('fltMat'), cs = $('fltCl');
  const mv = ms.value, cv = cs.value;

  ms.innerHTML = '<option value="">Toutes les mati\u00e8res</option>' +
    allM.map(m => { const mo = D.matieres.find(x => x.id===m)||{name:m}; return '<option value="'+m+'"'+(m===mv?' selected':'')+'>'+mo.name+'</option>'; }).join('');
  cs.innerHTML = '<option value="">Tous les classeurs</option>' +
    allC.map(c => { const co = D.classeurs.find(x => x.id===c)||{name:c}; return '<option value="'+c+'"'+(c===cv?' selected':'')+'>'+co.name+'</option>'; }).join('');

  $('matChips').innerHTML =
    '<button class="chip' + (chipFilter===null?' on':'') + '" data-chip="null">Tous</button>' +
    D.matieres.map(m =>
      '<button class="chip' + (chipFilter===m.id?' on':'') + '" data-chip="' + m.id + '" style="' +
      (chipFilter===m.id ? 'background:'+m.color+';border-color:'+m.color : 'border-color:'+m.color+'60;color:'+m.color) +
      '">' + m.label + '</button>'
    ).join('');
  $('matChips').querySelectorAll('.chip').forEach(btn => {
    btn.addEventListener('click', () => { chipFilter = btn.dataset.chip==='null' ? null : btn.dataset.chip; renderCours(); });
  });

  const q = $('mainSearch').value.toLowerCase().trim();
  const qrf = $('fltQr').value;
  const list = D.cours.filter(c => {
    const mo = D.matieres.find(x => x.id===c.mat)||{name:''};
    return (!q || c.title.toLowerCase().includes(q) || c.uid.toLowerCase().includes(q) || mo.name.toLowerCase().includes(q) || (c.desc||'').toLowerCase().includes(q))
      && (!ms.value || c.mat===ms.value)
      && (!cs.value || c.cl===cs.value)
      && (!chipFilter || c.mat===chipFilter)
      && (!qrf || (qrf==='pending'&&!c.qrPrinted) || (qrf==='done'&&c.qrPrinted));
  });

  const grid = $('coursGrid');
  if (!list.length) {
    grid.innerHTML = '<div class="empty"><div class="e">\ud83d\udced</div><h3>Aucun cours trouv\u00e9</h3><p>Modifie les filtres ou ajoute un cours.</p></div>';
    renderStats(); return;
  }

  grid.innerHTML = list.map(c => {
    const mo = D.matieres.find(x => x.id===c.mat) || {color:'#6a6a88', label:c.mat, name:c.mat};
    const co = D.classeurs.find(x => x.id===c.cl) || {name:c.cl, icon:'\ud83d\udcc1'};
    const interNum = parseInt(c.inter, 10);
    return '<div class="card" style="border-left-color:' + mo.color + '" data-uid="' + c.uid + '">' +
      '<div class="ctop">' +
        '<div class="cbadges">' +
          '<span class="bm" style="background:'+mo.color+'20;color:'+mo.color+';border:1px solid '+mo.color+'60">'+mo.label+'</span>' +
          '<span class="bu">'+c.uid+'</span>' +
        '</div>' +
        '<div class="cacts">' +
          '<button class="cbt" data-action="loc" data-uid="'+c.uid+'" title="Localiser">\ud83d\udccd</button>' +
          '<button class="cbt" data-action="qr" data-uid="'+c.uid+'" title="QR Code">\u25a3</button>' +
          '<button class="cbt" data-action="edit" data-uid="'+c.uid+'">\u270f\ufe0f</button>' +
          '<button class="cbt" data-action="del" data-uid="'+c.uid+'">\ud83d\uddd1\ufe0f</button>' +
        '</div>' +
      '</div>' +
      '<div class="ctitle">'+c.title+'</div>' +
      '<div class="clocs">' +
        '<span class="cloc cloc-a">'+co.icon+' '+co.name+'</span>' +
        '<span class="cloc cloc-b">\ud83d\udcd1 Inter.'+c.inter+' \u00b7 '+(IN[interNum]||'')+'</span>' +
      '</div>' +
      (c.date ? '<span class="mt">\ud83d\udcc5 '+fmtD(c.date)+'</span>' : '') +
      (c.desc ? '<div class="cdesc">'+c.desc+'</div>' : '') +
      (!c.qrPrinted ? '<div class="qr-warn">\u26a0\ufe0f QR code non encore imprim\u00e9</div>' : '') +
    '</div>';
  }).join('');

  grid.querySelectorAll('.cbt').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const uid = btn.dataset.uid, act = btn.dataset.action;
      if (act==='loc') showLocPopup(uid);
      else if (act==='qr') showQR(uid);
      else if (act==='edit') editCours(uid);
      else if (act==='del') delCours(uid);
    });
  });
  // Clic sur une carte → localiser
  grid.querySelectorAll('.card').forEach(card => {
    card.addEventListener('click', () => showLocPopup(card.dataset.uid));
  });

  renderStats();
}

function delCours(uid) {
  if (!confirm('Supprimer le cours ' + uid + ' ?')) return;
  D.cours = D.cours.filter(c => c.uid !== uid);
  save(); renderCours();
}

function editCours(uid) {
  const c = D.cours.find(x => x.uid===uid); if (!c) return;
  editUid = uid;
  $('mTitle').textContent = '\u270f\ufe0f Modifier le cours';
  $('fTitle').value = c.title;
  $('fDesc').value = c.desc || '';
  $('fDate').value = c.date || '';
  popSel(c.mat, c.cl, c.inter);
  $('uidBox').innerHTML = c.uid + '<small>Code permanent \u2014 ne change jamais</small>';
  $('ovCours').classList.remove('hidden');
}

// ══════════════════════════════════════════════
// QR CODE (qrcodejs)
// ══════════════════════════════════════════════
function makeQRCodeInto(container, text, size) {
  container.innerHTML = '';
  if (typeof QRCode === 'undefined') {
    container.innerHTML = '<div style="color:var(--red);font-size:11px;padding:5px">QRCode.js non charg\u00e9<br>(v\u00e9rifie ta connexion)</div>';
    return null;
  }
  return new QRCode(container, {
    text: text,
    width: size,
    height: size,
    colorDark: '#000000',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.M
  });
}

function showQR(uid) {
  const c = D.cours.find(x => x.uid===uid); if (!c) return;
  curQRUid = uid;
  const mo = D.matieres.find(m => m.id===c.mat) || {name:c.mat};
  const co = D.classeurs.find(x => x.id===c.cl) || {name:c.cl};
  $('qrTitle').textContent = '\ud83d\udcf1 ' + c.title;
  $('qrSub').textContent = mo.name + ' \u00b7 ' + co.name + ' \u00b7 Intercalaire ' + c.inter;
  $('qrLbl').textContent = uid;
  makeQRCodeInto($('qrBox'), uid, 180);
  $('btnMarkOnePrinted').textContent = c.qrPrinted ? '\u21a9 Marquer non-imprim\u00e9' : '\u2705 Marquer imprim\u00e9';
  $('ovQR').classList.remove('hidden');
}

function markOnePrinted() {
  const c = D.cours.find(x => x.uid===curQRUid); if (!c) return;
  c.qrPrinted = !c.qrPrinted; save(); renderCours();
  $('btnMarkOnePrinted').textContent = c.qrPrinted ? '\u21a9 Marquer non-imprim\u00e9' : '\u2705 Marquer imprim\u00e9';
}

function dlQR() {
  const box = $('qrBox');
  // qrcodejs génère un canvas ET une img
  const img = box.querySelector('img');
  const canvas = box.querySelector('canvas');
  const src = img ? img.src : (canvas ? canvas.toDataURL('image/png') : null);
  if (!src) { alert('QR non disponible'); return; }
  // Créer un canvas composite avec le code en bas
  const cv = document.createElement('canvas');
  cv.width = 220; cv.height = 245;
  const ctx = cv.getContext('2d');
  ctx.fillStyle = '#fff'; ctx.fillRect(0,0,220,245);
  const qrImg = new Image();
  qrImg.onload = () => {
    ctx.drawImage(qrImg, 20, 10, 180, 180);
    ctx.fillStyle = '#000'; ctx.font = 'bold 12px monospace'; ctx.textAlign = 'center';
    ctx.fillText(curQRUid, 110, 208);
    const c = D.cours.find(x => x.uid===curQRUid);
    if (c) { ctx.font = '10px sans-serif'; ctx.fillText(c.title.slice(0,30), 110, 225); }
    const a = document.createElement('a');
    a.download = 'qr-' + curQRUid.replace(/-/g,'_') + '.png';
    a.href = cv.toDataURL('image/png'); a.click();
  };
  qrImg.src = src;
}

// ══════════════════════════════════════════════
// IMPRESSION
// ══════════════════════════════════════════════
function renderPrintGrid() {
  const grid = $('printGrid');
  if (!D.cours.length) { grid.innerHTML='<div class="empty">Aucun cours.</div>'; return; }

  grid.innerHTML = D.cours.map(c =>
    '<div class="pcard' + (printSel.has(c.uid)?' sel':'') + '" data-uid="' + c.uid + '">' +
      '<div class="pc-check">' + (printSel.has(c.uid)?'\u2705':'\u2b1c') + '</div>' +
      '<div class="pc-qr" id="pqr_' + c.uid.replace(/-/g,'_') + '"></div>' +
      '<div class="pc-uid">' + c.uid + '</div>' +
      '<div class="pc-title">' + c.title + '</div>' +
    '</div>'
  ).join('');

  // Générer les QR dans chaque card
  D.cours.forEach(c => {
    const el = document.getElementById('pqr_' + c.uid.replace(/-/g,'_'));
    if (el) makeQRCodeInto(el, c.uid, 80);
  });

  $('pStats').textContent = printSel.size + ' cours s\u00e9lectionn\u00e9(s)';

  grid.querySelectorAll('.pcard').forEach(card => {
    card.addEventListener('click', () => {
      const uid = card.dataset.uid;
      if (printSel.has(uid)) printSel.delete(uid); else printSel.add(uid);
      renderPrintGrid();
    });
  });
}

function doPrint() {
  const sel = D.cours.filter(c => printSel.has(c.uid));
  if (!sel.length) { alert('S\u00e9lectionne au moins un cours !'); return; }

  // Construire la zone d'impression
  const pz = $('printZone');
  pz.innerHTML = '';

  sel.forEach(c => {
    const mo = D.matieres.find(m => m.id===c.mat) || {name:c.mat};
    const co = D.classeurs.find(x => x.id===c.cl) || {name:c.cl};
    const label = document.createElement('div');
    label.className = 'print-label';

    // Container QR : qrcodejs génère canvas + img, l'img fonctionne à l'impression
    const qrWrap = document.createElement('div');
    qrWrap.className = 'qr-img-wrap';
    qrWrap.style.cssText = 'width:28mm;height:28mm;background:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto;';
    label.appendChild(qrWrap);

    label.innerHTML +=
      '<div class="pl-uid">' + c.uid + '</div>' +
      '<div class="pl-title">' + c.title + '</div>' +
      '<div class="pl-loc">' + co.name + ' · Inter. ' + c.inter + '</div>';
    pz.appendChild(label);

    // Générer le QR code (taille fixe identique pour tous)
    makeQRCodeInto(qrWrap, c.uid, 100);
  });

  // Attendre que les QR soient générés, puis imprimer
  setTimeout(() => {
    window.print();
    // Proposer de marquer comme imprimés
    setTimeout(() => {
      if (confirm('Marquer ces ' + sel.length + ' cours comme "QR imprim\u00e9" ?')) {
        sel.forEach(c => { const x = D.cours.find(d => d.uid===c.uid); if (x) x.qrPrinted = true; });
        save(); renderCours(); renderPrintGrid();
      }
      pz.innerHTML = '';
    }, 500);
  }, 600);
}

// ══════════════════════════════════════════════
// CLASSEURS
// ══════════════════════════════════════════════
function renderClasseurs() {
  const g = $('clGrid');
  if (!D.classeurs.length) { g.innerHTML='<div class="empty"><div class="e">\ud83d\uddc2\ufe0f</div><h3>Aucun classeur</h3></div>'; return; }
  g.innerHTML = D.classeurs.map(cl => {
    const cc = D.cours.filter(c => c.cl===cl.id);
    return '<div class="cl-card">' +
      '<div class="cl-hdr" data-cl="'+cl.id+'">' +
        '<div class="cl-ico" style="background:'+cl.color+'20">'+cl.icon+'</div>' +
        '<div class="cl-info"><div class="cl-nm">'+cl.name+'</div><div class="cl-sb">'+cc.length+' cours \u00b7 ID: '+cl.id+'</div></div>' +
        '<div class="cl-tog" id="tog_'+cl.id+'">\u25bc</div>' +
      '</div>' +
      '<div class="ilist" id="ili_'+cl.id+'">' +
        Array.from({length:12},(_,i)=>i+1).map(n => {
          const ns = String(n).padStart(2,'0');
          const items = cc.filter(c => c.inter===ns);
          return '<div class="irow" data-cl="'+cl.id+'" data-n="'+ns+'">' +
            '<div class="inum">'+ns+'</div>' +
            '<div class="ilbl">'+IN[n]+'</div>' +
            '<div class="icnt">'+(items.length ? items.length+' cours' : '\u2014')+'</div>' +
          '</div>' +
          (items.length ? '<div class="iitems">'+items.map(x=>'<div class="iitem">'+x.uid+' <span style="color:var(--txt);font-family:sans-serif">\u2014 '+x.title+'</span></div>').join('')+'</div>' : '');
        }).join('') +
      '</div>' +
    '</div>';
  }).join('');

  g.querySelectorAll('.cl-hdr').forEach(h => {
    h.addEventListener('click', () => {
      const id = h.dataset.cl;
      $('ili_'+id).classList.toggle('open');
      $('tog_'+id).classList.toggle('open');
    });
  });
  g.querySelectorAll('.irow').forEach(r => {
    r.addEventListener('click', () => {
      switchTab('cours');
      $('fltCl').value = r.dataset.cl;
      chipFilter = null; renderCours();
      window.scrollTo({top:0,behavior:'smooth'});
    });
  });
}

// ══════════════════════════════════════════════
// MATIÈRES
// ══════════════════════════════════════════════
function renderMatieres() {
  const el = $('mgMat');
  el.innerHTML =
    '<p class="sttl" style="margin-top:0">Mati\u00e8res \u2014 pr\u00e9fixe 4 lettres</p>' +
    D.matieres.map(m =>
      '<div class="mr">' +
        '<div class="mdot" style="background:'+m.color+'"></div>' +
        '<div class="mlbl">'+m.label+'</div>' +
        '<div class="mnm">'+m.name+'</div>' +
        '<div class="mcnt">'+D.cours.filter(c=>c.mat===m.id).length+' cours</div>' +
        '<button class="mdel" data-id="'+m.id+'" data-type="mat">\u2715</button>' +
      '</div>'
    ).join('') +
    '<div class="nrow">' +
      '<input class="fi" type="text" id="nMlbl" placeholder="ABCD" maxlength="4" style="width:80px;max-width:80px">' +
      '<input class="fi" type="text" id="nMname" placeholder="Nom complet" style="flex:1;min-width:80px">' +
      '<div class="sws" id="swMat"></div>' +
      '<button class="bp" id="btnAddMat" style="flex:0;padding:8px 12px;border-radius:8px;font-size:12px;white-space:nowrap">+ Matière</button>' +
    '</div>' +
    '<p class="sttl">Classeurs \u2014 ID 1 lettre</p>' +
    D.classeurs.map(cl =>
      '<div class="mr">' +
        '<div style="font-size:14px">'+cl.icon+'</div>' +
        '<div class="mlbl">['+cl.id+']</div>' +
        '<div class="mnm">'+cl.name+'</div>' +
        '<div class="mcnt">'+D.cours.filter(c=>c.cl===cl.id).length+' cours</div>' +
        '<button class="mdel" data-id="'+cl.id+'" data-type="cl">\u2715</button>' +
      '</div>'
    ).join('') +
    '<div class="nrow">' +
      '<input class="fi" type="text" id="nClId" placeholder="A" maxlength="1" style="width:55px;max-width:55px">' +
      '<input class="fi" type="text" id="nClNm" placeholder="Nom du classeur" style="flex:1;min-width:80px">' +
      '<input class="fi" type="text" id="nClIc" placeholder="\ud83d\udcd2" style="width:42px;max-width:42px">' +
      '<button class="bp" id="btnAddCl" style="flex:0;padding:8px 12px;border-radius:8px;font-size:12px;white-space:nowrap">+ Classeur</button>' +
    '</div>';

  $('swMat').innerHTML = COLORS.map(c =>
    '<div class="sw'+(c===newColor?' on':'')+'" style="background:'+c+'" data-col="'+c+'"></div>'
  ).join('');
  $('swMat').querySelectorAll('.sw').forEach(sw => {
    sw.addEventListener('click', () => { newColor = sw.dataset.col; renderMatieres(); });
  });
  el.querySelectorAll('.mdel').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.type==='mat') delMat(btn.dataset.id);
      else delCl(btn.dataset.id);
    });
  });
  $('btnAddMat').addEventListener('click', addMat);
  $('btnAddCl').addEventListener('click', addCl);
}

function addMat() {
  const lbl = $('nMlbl').value.trim().toUpperCase();
  const name = $('nMname').value.trim();
  if (lbl.length !== 4 || !/^[A-Z]{4}$/.test(lbl)) { alert('Le pr\u00e9fixe doit faire exactement 4 lettres (ex: PHYS)'); return; }
  if (D.matieres.find(m => m.id===lbl)) { alert('Ce pr\u00e9fixe existe d\u00e9j\u00e0 !'); return; }
  D.matieres.push({id:lbl, label:lbl, name:name||lbl, color:newColor});
  save(); renderMatieres(); renderCours();
}
function delMat(id) {
  if (D.cours.filter(c=>c.mat===id).length && !confirm('Des cours utilisent cette mati\u00e8re. Continuer ?')) return;
  D.matieres = D.matieres.filter(m => m.id!==id); save(); renderMatieres(); renderCours();
}
function addCl() {
  const id = $('nClId').value.trim().toUpperCase();
  const name = $('nClNm').value.trim();
  const icon = $('nClIc').value.trim() || '\ud83d\udcc1';
  if (id.length!==1 || !/[A-Z]/.test(id)) { alert('L\'ID doit \u00eatre exactement 1 lettre'); return; }
  if (D.classeurs.find(c=>c.id===id)) { alert('Cet ID existe d\u00e9j\u00e0 !'); return; }
  if (!name) { alert('Nom obligatoire !'); return; }
  D.classeurs.push({id, name, icon, color:newColor}); save(); renderMatieres(); renderCours();
}
function delCl(id) {
  if (D.cours.filter(c=>c.cl===id).length && !confirm('Des cours sont dans ce classeur. Continuer ?')) return;
  D.classeurs = D.classeurs.filter(c => c.id!==id); save(); renderMatieres(); renderCours();
}

// ══════════════════════════════════════════════
// MODAL COURS
// ══════════════════════════════════════════════
function openModal() {
  editUid = null;
  $('mTitle').textContent = '\u270f\ufe0f Ajouter un cours';
  $('fTitle').value = ''; $('fDesc').value = '';
  $('fDate').value = new Date().toISOString().split('T')[0];
  popSel('','','');
  $('uidBox').innerHTML = '\u2014<small>G\u00e9n\u00e9r\u00e9 automatiquement (code permanent)</small>';
  $('ovCours').classList.remove('hidden');
}
function closeModal() { $('ovCours').classList.add('hidden'); }
function popSel(mat, cl, inter) {
  $('fMat').innerHTML = D.matieres.map(m => '<option value="'+m.id+'"'+(m.id===mat?' selected':'')+'>'+m.label+' \u2014 '+m.name+'</option>').join('');
  $('fCl').innerHTML = '<option value="">\u2014 Choisir \u2014</option>' +
    D.classeurs.map(c => '<option value="'+c.id+'"'+(c.id===cl?' selected':'')+'>'+c.icon+' '+c.name+'</option>').join('');
  $('fInter').value = inter || '';
  updateUid();
}
function updateUid() {
  const mat = $('fMat').value;
  if (editUid) {
    $('uidBox').innerHTML = editUid + '<small>Code permanent \u2014 ne change jamais</small>';
  } else if (mat) {
    const preview = genUid(mat);
    $('uidBox').innerHTML = '<span style="opacity:.5">' + preview + '</span><small>Exemple du code qui sera g\u00e9n\u00e9r\u00e9</small>';
  } else {
    $('uidBox').innerHTML = '\u2014<small>Choisis une mati\u00e8re pour voir un exemple</small>';
  }
}
function saveCours() {
  const title = $('fTitle').value.trim();
  const mat = $('fMat').value;
  const cl = $('fCl').value;
  const inter = $('fInter').value;
  if (!title) { alert('Titre obligatoire !'); return; }
  if (!mat) { alert('Choisis une mati\u00e8re !'); return; }
  if (!cl) { alert('Choisis un classeur !'); return; }
  if (!inter) { alert('Choisis un intercalaire !'); return; }

  const obj = {title, mat, cl, inter, desc: $('fDesc').value.trim(), date: $('fDate').value, qrPrinted: false};
  if (editUid) {
    const idx = D.cours.findIndex(c => c.uid===editUid);
    obj.uid = D.cours[idx].uid;
    obj.qrPrinted = D.cours[idx].qrPrinted;
    D.cours[idx] = obj;
  } else {
    obj.uid = genUid(mat);
    D.cours.unshift(obj);
  }
  save(); closeModal(); renderCours();
}

// ══════════════════════════════════════════════
// CAMERA (jsQR)
// ══════════════════════════════════════════════
function openCam() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    alert('Cam\u00e9ra non disponible. Utilise Chrome sur t\u00e9l\u00e9phone.'); return;
  }
  $('ovCam').classList.remove('hidden');
  $('camSt').textContent = 'Demande d\'acc\u00e8s \u00e0 la cam\u00e9ra...';
  navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:640},height:{ideal:640}}})
    .then(stream => {
      camStream = stream;
      const v = $('camVideo'); v.srcObject = stream; v.play();
      if (typeof jsQR !== 'undefined') {
        $('camSt').textContent = '\ud83d\udd0d Recherche d\'un QR code...';
        camTick = setInterval(() => scanFrame(v), 250);
      } else {
        $('camSt').textContent = '\u26a0 jsQR non charg\u00e9 \u2014 v\u00e9rifie ta connexion internet';
      }
    })
    .catch(err => { $('camSt').textContent = '\u274c Cam\u00e9ra refus\u00e9e : ' + err.message; });
}

function scanFrame(video) {
  if (video.readyState !== 4 || typeof jsQR === 'undefined') return;
  const cv = $('camCanvas');
  cv.width = video.videoWidth; cv.height = video.videoHeight;
  const ctx = cv.getContext('2d'); ctx.drawImage(video,0,0);
  const d = ctx.getImageData(0,0,cv.width,cv.height);
  const code = jsQR(d.data, d.width, d.height, {inversionAttempts:'dontInvert'});
  if (code && code.data) {
    const uid = code.data.trim().toUpperCase();
    stopCam();
    $('mainSearch').value = uid;
    showLocPopup(uid);
  }
}

function stopCam() {
  if (camTick) { clearInterval(camTick); camTick = null; }
  if (camStream) { camStream.getTracks().forEach(t => t.stop()); camStream = null; }
  const v = $('camVideo'); if (v) v.srcObject = null;
  $('ovCam').classList.add('hidden');
  $('camSt').textContent = 'Initialisation...';
}

// ══════════════════════════════════════════════
// CSV
// ══════════════════════════════════════════════
function exportCSV() {
  const hdr = ['Code','Titre','Matiere','Classeur','Intercalaire','Section','Description','Date','QR_Imprime'];
  const esc = v => '"' + String(v||'').replace(/"/g,'""') + '"';
  const rows = D.cours.map(c => {
    const mo = D.matieres.find(m=>m.id===c.mat)||{name:c.mat};
    const co = D.classeurs.find(x=>x.id===c.cl)||{name:c.cl};
    const interNum = parseInt(c.inter,10);
    return [c.uid,c.title,mo.name,co.name,c.inter,IN[interNum]||'',c.desc||'',c.date||'',c.qrPrinted?'Oui':'Non'].map(esc).join(',');
  });
  const csv = [hdr.join(','), ...rows].join('\n');
  const blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='mes-cours-'+new Date().toISOString().split('T')[0]+'.csv'; a.click();
  URL.revokeObjectURL(url);
}

