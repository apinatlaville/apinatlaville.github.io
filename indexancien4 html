<script>
(function(){
'use strict';

// ══════════════════════════════════════════════
// CONSTANTES
// ══════════════════════════════════════════════
const IN = ['','Intro','Cours 1','Cours 2','Cours 3','Cours 4','Cours 5','Exercices','TD','TP','Fiches','Annales','Divers'];
const COLORS = ['#5b8df7','#f0c060','#50d890','#f06060','#b06af7','#f06ab0','#60d0f0','#f09060'];
const SEP = '\u00b7'; // ·

// ══════════════════════════════════════════════
// GÉNÉRATION DE CODE PERMANENT
// Code = MAT + '-' + 4 chars aléatoires (MAJ+chiffres)
// Ex: PHYS-K7M2, MATH-3XQA
// Ce code est généré UNE FOIS et ne change JAMAIS
// Il ne dépend pas de l'intercalaire ou du classeur
// ══════════════════════════════════════════════
function genUid(matId) {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let rnd = '';
  for (let i = 0; i < 4; i++) rnd += chars[Math.floor(Math.random() * chars.length)];
  return matId.slice(0,4) + '-' + rnd;
}

// ══════════════════════════════════════════════
// AUTO-FORMAT de la barre de scan
// Format: PHYS-K7M2 (4 lettres + tiret + 4 alphanum)
// L'utilisateur tape "PHYSK7M2" → "PHYS-K7M2"
// ══════════════════════════════════════════════
function autoFmtScan() {
  const el = $('mainSearch');
  const raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g,'');
  let s1='', s2='';
  let i = 0;
  while(i < raw.length && /[A-Z]/.test(raw[i]) && s1.length < 4) s1 += raw[i++];
  while(i < raw.length && s2.length < 4) s2 += raw[i++];
  let res = s1;
  if(s2) res += '-' + s2;
  // Seulement réécrire si ressemble à un code (pas une recherche texte)
  if(raw.length > 0 && raw.length <= 8 && /^[A-Z]{1,4}[A-Z0-9]{0,4}$/.test(raw)) {
    if(el.value !== res) { el.value = res; el.selectionStart = el.selectionEnd = res.length; }
  }
}

// ══════════════════════════════════════════════
// DONNÉES
// ══════════════════════════════════════════════
let D = JSON.parse(localStorage.getItem('mc_v9') || 'null') || {
  matieres: [
    {id:'PHYS', label:'PHYS', name:'Physique', color:'#5b8df7'},
    {id:'MATH', label:'MATH', name:'Math\u00e9matiques', color:'#f0c060'},
    {id:'CHIM', label:'CHIM', name:'Chimie', color:'#50d890'},
  ],
  classeurs: [
    {id:'A', name:'Classeur Physique A', icon:'\ud83d\udcd8', color:'#5b8df7'},
    {id:'B', name:'Classeur Physique B', icon:'\ud83d\udcd7', color:'#b06af7'},
    {id:'C', name:'Classeur Maths', icon:'\ud83d\udcd9', color:'#f0c060'},
  ],
  cours: [
    {uid:'PHYS-TEST', title:'QR Code de Test (commun)', mat:'PHYS', cl:'A', inter:'01', desc:'Code test toujours pr\u00e9sent pour v\u00e9rifier le syst\u00e8me', date:'2025-01-01', qrPrinted:false},
    {uid:'PHYS-K7M2', title:'Les lois de Newton', mat:'PHYS', cl:'A', inter:'01', desc:'Inertie, F=ma, action-r\u00e9action', date:'2025-03-10', qrPrinted:false},
    {uid:'MATH-3XQA', title:'D\u00e9riv\u00e9es et int\u00e9grales', mat:'MATH', cl:'C', inter:'02', desc:'R\u00e8gles de d\u00e9rivation', date:'2025-03-12', qrPrinted:true},
    {uid:'CHIM-9BP5', title:'Liaison covalente', mat:'CHIM', cl:'A', inter:'03', desc:"Partage d'\u00e9lectrons", date:'2025-03-15', qrPrinted:false},
    {uid:'PHYS-2RNV', title:'Optique g\u00e9om\u00e9trique', mat:'PHYS', cl:'B', inter:'01', desc:'R\u00e9flexion, r\u00e9fraction', date:'2025-03-18', qrPrinted:false},
  ]
};

let editUid = null;
let chipFilter = null;
let newColor = COLORS[0];
let curQRUid = null;
let printSel = new Set();
let camStream = null;
let camTick = null;

const save = () => localStorage.setItem('mc_v9', JSON.stringify(D));
const $ = id => document.getElementById(id);
const fmtD = d => { if(!d) return ''; const [y,m,j] = d.split('-'); return j+'/'+m+'/'+y; };

// ══════════════════════════════════════════════
// LOCALISATION (popup slide-in depuis le bas)
// ══════════════════════════════════════════════
function showLocPopup(uid) {
  const c = D.cours.find(x => x.uid === uid);
