<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mes Cours</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<!-- QRCode.js : génère de vrais QR codes (canvas + img) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<!-- jsQR : lecture QR via caméra -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js"></script>
<style>
:root{
  --bg:#0c0c10;--s1:#141418;--s2:#1c1c22;--s3:#252530;
  --bd:#2a2a3a;--acc:#5b8df7;--glow:rgba(91,141,247,.18);
  --gold:#f0c060;--grn:#50d890;--red:#f06060;
  --txt:#e4e4f0;--mut:#6a6a88;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--txt);font-family:'DM Sans',sans-serif;min-height:100vh;padding-bottom:90px;}

/* HEADER */
.hdr{background:linear-gradient(150deg,#0e1628,#0c0c10);padding:20px 16px 14px;border-bottom:1px solid var(–bd);position:relative;overflow:hidden;}
.hdr::after{content:’’;position:absolute;top:-30px;right:-30px;width:120px;height:120px;background:radial-gradient(circle,var(–glow),transparent 70%);border-radius:50%;}
.hdr h1{font-family:‘Syne’,sans-serif;font-size:20px;font-weight:800;}
.hdr h1 span{color:var(–acc);}
.hdr p{color:var(–mut);font-size:11px;margin-top:2px;}

/* STATS */
.stats-band{background:var(–s3);border-bottom:1px solid var(–bd);padding:8px 14px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;}
.stats-band::-webkit-scrollbar{display:none;}
.stc{display:flex;align-items:center;gap:5px;background:var(–s2);border:1px solid var(–bd);border-radius:20px;padding:4px 10px;font-size:11px;white-space:nowrap;flex-shrink:0;}
.dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}

/* SEARCH BAR */
.search-bar{background:var(–s2);border-bottom:1px solid var(–bd);padding:10px 14px;display:flex;gap:8px;align-items:center;position:sticky;top:0;z-index:50;}
.search-bar input{flex:1;background:var(–bg);border:1.5px solid var(–bd);border-radius:9px;padding:9px 12px;color:var(–txt);font-family:‘DM Sans’,sans-serif;font-size:14px;outline:none;transition:border-color .2s,box-shadow .2s;}
.search-bar input:focus{border-color:var(–acc);box-shadow:0 0 0 3px var(–glow);}
.sbtn{border:none;border-radius:9px;padding:9px 14px;font-family:‘Syne’,sans-serif;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;transition:opacity .2s;}
.sbtn-loc{background:var(–acc);color:#fff;}
.sbtn-loc:hover{opacity:.85;}

/* TABS */
.tabs{display:flex;background:var(–s1);border-bottom:1px solid var(–bd);padding:0 10px;overflow-x:auto;scrollbar-width:none;}
.tabs::-webkit-scrollbar{display:none;}
.tab{background:none;border:none;border-bottom:2px solid transparent;color:var(–mut);font-family:‘Syne’,sans-serif;font-size:12px;font-weight:700;padding:10px 12px;cursor:pointer;white-space:nowrap;transition:color .2s;margin-bottom:-1px;}
.tab.on{color:var(–txt);border-bottom-color:var(–acc);}

/* PANES */
.pane{padding:14px;display:none;}
.pane.on{display:block;}

/* FILTERS */
.filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;}
.fi{background:var(–s2);border:1px solid var(–bd);border-radius:8px;padding:8px 10px;color:var(–txt);font-family:‘DM Sans’,sans-serif;font-size:12px;outline:none;flex:1;min-width:100px;cursor:pointer;}
.fi:focus{border-color:var(–acc);}
.chips{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:12px;}
.chip{padding:4px 11px;border-radius:20px;border:1.5px solid var(–bd);background:transparent;color:var(–mut);font-size:12px;font-family:‘Syne’,sans-serif;font-weight:700;cursor:pointer;transition:all .15s;}
.chip.on{background:var(–acc);border-color:var(–acc);color:#fff;}

/* CARDS */
.cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:10px;}
.card{background:var(–s1);border:1px solid var(–bd);border-left:3px solid;border-radius:11px;padding:13px;transition:all .2s;cursor:pointer;}
.card:hover{transform:translateY(-1px);box-shadow:0 5px 18px rgba(0,0,0,.3);}
.ctop{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;gap:5px;}
.cbadges{display:flex;gap:4px;flex-wrap:wrap;flex:1;}
.bm{font-family:‘DM Mono’,monospace;font-size:10px;letter-spacing:.8px;padding:2px 7px;border-radius:4px;}
.bu{font-family:‘DM Mono’,monospace;font-size:10px;letter-spacing:.8px;padding:2px 8px;border-radius:4px;background:rgba(91,141,247,.1);color:var(–acc);border:1px solid rgba(91,141,247,.4);}
.cacts{display:flex;gap:2px;flex-shrink:0;}
.cbt{background:none;border:none;cursor:pointer;padding:3px 5px;border-radius:4px;font-size:13px;transition:background .15s;}
.cbt:hover{background:var(–s2);}
.ctitle{font-family:‘Syne’,sans-serif;font-size:14px;font-weight:700;margin-bottom:6px;line-height:1.3;}
.clocs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:5px;}
.cloc{font-size:11px;padding:2px 8px;border-radius:5px;}
.cloc-a{background:rgba(91,141,247,.12);color:var(–acc);}
.cloc-b{background:rgba(240,192,96,.12);color:var(–gold);}
.mt{font-size:11px;color:var(–mut);background:var(–s2);border-radius:4px;padding:2px 6px;}
.cdesc{font-size:12px;color:var(–mut);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:5px;}
.qr-warn{display:flex;align-items:center;gap:5px;margin-top:6px;font-size:11px;color:var(–gold);background:rgba(240,192,96,.1);border:1px solid rgba(240,192,96,.3);border-radius:5px;padding:3px 8px;}

/* PRINT PANE */
.pbar{background:var(–s2);border:1px solid var(–bd);border-radius:11px;padding:13px;margin-bottom:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;}
.pcard{background:var(–s1);border:1px solid var(–bd);border-radius:9px;padding:10px 8px;text-align:center;cursor:pointer;transition:all .15s;position:relative;}
.pcard.sel{border-color:var(–acc);background:rgba(91,141,247,.06);}
.pcard:hover{border-color:var(–acc);}
.pc-check{position:absolute;top:6px;right:6px;font-size:12px;}
.pc-qr{width:80px;height:80px;background:#fff;border-radius:6px;margin:0 auto 6px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.pc-qr canvas,.pc-qr img{width:80px!important;height:80px!important;}
.pc-uid{font-family:‘DM Mono’,monospace;font-size:9px;color:var(–acc);margin-bottom:2px;word-break:break-all;}
.pc-title{font-size:10px;color:var(–mut);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}

/* CLASSEURS */
.cl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(275px,1fr));gap:11px;}
.cl-card{background:var(–s1);border:1px solid var(–bd);border-radius:11px;overflow:hidden;}
.cl-hdr{padding:12px 14px;display:flex;align-items:center;gap:9px;cursor:pointer;transition:background .15s;}
.cl-hdr:hover{background:var(–s2);}
.cl-ico{width:32px;height:32px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.cl-info{flex:1;}
.cl-nm{font-family:‘Syne’,sans-serif;font-size:14px;font-weight:700;}
.cl-sb{font-size:11px;color:var(–mut);}
.cl-tog{color:var(–mut);font-size:11px;transition:transform .2s;}
.cl-tog.open{transform:rotate(180deg);}
.ilist{padding:6px 8px 9px;display:none;border-top:1px solid var(–bd);}
.ilist.open{display:block;}
.irow{display:flex;align-items:center;gap:6px;padding:5px 7px;border-radius:6px;cursor:pointer;transition:background .15s;}
.irow:hover{background:var(–s2);}
.inum{width:24px;height:18px;background:var(–s3);border-radius:3px;font-family:‘DM Mono’,monospace;font-size:10px;display:flex;align-items:center;justify-content:center;color:var(–gold);flex-shrink:0;}
.ilbl{font-size:12px;flex:1;}
.icnt{font-size:11px;color:var(–mut);font-family:‘DM Mono’,monospace;}
.iitems{padding-left:30px;}
.iitem{font-size:11px;color:var(–mut);padding:1px 0;font-family:‘DM Mono’,monospace;}

/* MATIÈRES */
.mg{display:flex;flex-direction:column;gap:7px;}
.mr{display:flex;align-items:center;gap:8px;background:var(–s2);border:1px solid var(–bd);border-radius:8px;padding:9px 12px;}
.mdot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.mlbl{font-family:‘Syne’,sans-serif;font-weight:700;font-size:13px;}
.mnm{color:var(–mut);font-size:12px;flex:1;}
.mcnt{color:var(–mut);font-size:11px;font-family:‘DM Mono’,monospace;}
.mdel{background:none;border:none;cursor:pointer;color:var(–red);font-size:14px;padding:2px;}
.nrow{display:flex;gap:6px;align-items:center;margin-top:8px;flex-wrap:wrap;}
.sws{display:flex;gap:4px;flex-wrap:wrap;}
.sw{width:20px;height:20px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:transform .15s,border-color .15s;flex-shrink:0;}
.sw.on,.sw:hover{transform:scale(1.2);border-color:#fff;}
.sttl{font-family:‘Syne’,sans-serif;font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(–mut);margin:16px 0 8px;}

/* MODALS */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.82);backdrop-filter:blur(5px);z-index:400;display:flex;align-items:center;justify-content:center;padding:14px;}
.modal{background:var(–s1);border:1px solid var(–bd);border-radius:16px;padding:20px;width:100%;max-width:420px;max-height:93vh;overflow-y:auto;position:relative;}
.modal h2{font-family:‘Syne’,sans-serif;font-size:16px;font-weight:800;margin-bottom:14px;padding-right:30px;}
.modal-x{position:absolute;top:18px;right:18px;background:none;border:none;color:var(–mut);font-size:20px;cursor:pointer;line-height:1;padding:2px 6px;border-radius:5px;transition:background .15s;}
.modal-x:hover{background:var(–s2);color:var(–txt);}
.fg{margin-bottom:11px;}
.fg label{display:block;font-size:11px;font-weight:500;color:var(–mut);margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px;}
.fg input,.fg textarea,.fg select{width:100%;background:var(–s2);border:1px solid var(–bd);border-radius:8px;padding:8px 11px;color:var(–txt);font-family:‘DM Sans’,sans-serif;font-size:13px;outline:none;transition:border-color .2s;resize:vertical;}
.fg input:focus,.fg textarea:focus,.fg select:focus{border-color:var(–acc);}
.uidbox{background:var(–s3);border:1px solid var(–bd);border-radius:8px;padding:10px 12px;font-family:‘DM Mono’,monospace;font-size:15px;letter-spacing:2px;color:var(–acc);text-align:center;margin-bottom:11px;}
.uidbox small{color:var(–mut);font-size:11px;display:block;margin-top:3px;letter-spacing:.3px;font-family:‘DM Sans’,sans-serif;}
.macts{display:flex;gap:7px;margin-top:13px;}
.bp{flex:1;background:var(–acc);border:none;border-radius:8px;padding:10px;color:#fff;font-family:‘Syne’,sans-serif;font-weight:700;font-size:13px;cursor:pointer;transition:opacity .2s;}
.bp:hover{opacity:.85;}
.bs{background:var(–s2);border:1px solid var(–bd);border-radius:8px;padding:10px 15px;color:var(–txt);font-family:‘Syne’,sans-serif;font-weight:600;font-size:13px;cursor:pointer;}
.bs:hover{background:var(–bd);}

/* LOCALISATION POPUP (pas une vraie modal, slide-in) */
.loc-popup{position:fixed;bottom:-400px;left:50%;transform:translateX(-50%);width:calc(100% - 32px);max-width:440px;background:var(–s1);border:1px solid var(–bd);border-radius:18px 18px 0 0;padding:20px;z-index:300;transition:bottom .3s cubic-bezier(.2,.8,.4,1);box-shadow:0 -8px 30px rgba(0,0,0,.5);}
.loc-popup.open{bottom:0;}
.loc-x{position:absolute;top:14px;right:14px;background:none;border:none;color:var(–mut);font-size:20px;cursor:pointer;padding:2px 6px;border-radius:5px;}
.loc-x:hover{background:var(–s2);}
.loc-code{font-family:‘DM Mono’,monospace;font-size:18px;letter-spacing:2px;color:var(–acc);margin-bottom:8px;}
.loc-title{font-family:‘Syne’,sans-serif;font-size:16px;font-weight:800;margin-bottom:12px;line-height:1.3;}
.loc-cards{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px;}
.loc-c{padding:8px 12px;border-radius:9px;font-size:13px;font-weight:500;}
.loc-cl{background:rgba(91,141,247,.15);color:var(–acc);border:1px solid var(–acc);}
.loc-in{background:rgba(240,192,96,.15);color:var(–gold);border:1px solid var(–gold);}
.loc-nu{background:rgba(80,216,144,.15);color:var(–grn);border:1px solid var(–grn);}
.loc-desc{font-size:12px;color:var(–mut);margin-top:6px;line-height:1.5;}

/* QR MODAL */
.m-center{text-align:center;}
.m-center p{color:var(–mut);font-size:12px;margin-bottom:14px;}
.qr-box{display:inline-block;background:#fff;padding:10px;border-radius:9px;margin-bottom:10px;line-height:0;}
.qr-box canvas,.qr-box img{display:block;}
.qr-lbl{font-family:‘DM Mono’,monospace;font-size:12px;letter-spacing:1.5px;color:var(–acc);margin-bottom:12px;}

/* CAMERA */
.cam-wrap{position:relative;width:100%;max-width:290px;margin:0 auto 10px;border-radius:11px;overflow:hidden;background:#000;aspect-ratio:1;}
#camVideo{width:100%;height:100%;object-fit:cover;display:block;}
.cam-line{position:absolute;left:10%;right:10%;height:2px;background:var(–acc);box-shadow:0 0 8px var(–acc);animation:sc 2s ease-in-out infinite;}
@keyframes sc{0%,100%{top:25%}50%{top:75%}}
.cam-st{font-size:12px;color:var(–mut);margin-bottom:10px;min-height:16px;text-align:center;}

/* FAB */
.fab-group{position:fixed;bottom:18px;right:16px;display:flex;flex-direction:column;align-items:center;gap:9px;z-index:200;}
.fab{width:48px;height:48px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:19px;transition:transform .2s,box-shadow .2s;box-shadow:0 3px 12px rgba(0,0,0,.4);}
.fab:hover{transform:scale(1.1);}
.fab-add{background:var(–acc);color:#fff;box-shadow:0 4px 14px rgba(91,141,247,.5);}
.fab-cam{background:var(–s2);border:1px solid var(–bd);color:var(–txt);}
.fab-csv{background:var(–grn);color:#0c0c10;}
.fab-print{background:var(–gold);color:#0c0c10;}

.empty{text-align:center;padding:44px 20px;color:var(–mut);grid-column:1/-1;}
.empty .e{font-size:38px;margin-bottom:11px;}
.empty h3{font-family:‘Syne’,sans-serif;color:var(–txt);margin-bottom:4px;font-size:15px;}
.hidden{display:none!important;}

/* ══ IMPRESSION ══ */
/* En mode écran : on montre les cards normalement */
#printZone{display:none;}

/* En mode impression : on cache tout sauf printZone */
@media print{
body>*{visibility:hidden;}
#printZone{
visibility:visible;
display:flex!important;
flex-wrap:wrap;
gap:10mm;
padding:8mm;
position:absolute;top:0;left:0;width:100%;
background:#fff;
}
.print-label{
visibility:visible;
width:38mm;height:auto;
border:1px solid #bbb;
border-radius:2mm;
padding:3mm;
text-align:center;
page-break-inside:avoid;
break-inside:avoid;
display:flex;flex-direction:column;align-items:center;
}
/* Forcer l’image QR (pas le canvas) à s’afficher */
.print-label .qr-img-wrap img{display:block!important;width:28mm!important;height:28mm!important;}
.print-label .qr-img-wrap canvas{display:none!important;}
.pl-uid{font-family:monospace;font-size:8px;letter-spacing:.5px;color:#333;margin:2mm 0 1mm;}
.pl-title{font-size:8px;font-weight:700;color:#000;margin-bottom:1mm;}
.pl-loc{font-size:7px;color:#555;}
}
</style>

</head>
<body>

<div class="hdr">
  <h1>📚 Mes <span>Cours</span></h1>
  <p>Codes fixes · QR · Localisation rapide</p>
</div>

<div class="stats-band" id="statsBand"></div>

<!-- BARRE DE RECHERCHE / LOCALISATION -->

<div class="search-bar">
  <input type="text" id="mainSearch" placeholder="🔍 Rechercher ou entrer un code pour localiser…">
  <button class="sbtn sbtn-loc" id="btnLocate">📍 Localiser</button>
</div>

<!-- TABS -->

<div class="tabs">
  <button class="tab on" data-tab="cours">📋 Cours</button>
  <button class="tab" data-tab="print">🖨 Impression</button>
  <button class="tab" data-tab="classeurs">🗂 Classeurs</button>
  <button class="tab" data-tab="matieres">🏷 Matières</button>
</div>

<!-- COURS -->

<div class="pane on" id="paneCours">
  <div class="filters">
    <select class="fi" id="fltMat"></select>
    <select class="fi" id="fltCl"></select>
    <select class="fi" id="fltQr">
      <option value="">Tous les états QR</option>
      <option value="pending">⚠ À imprimer</option>
      <option value="done">✅ Imprimé</option>
    </select>
  </div>
  <div class="chips" id="matChips"></div>
  <div class="cgrid" id="coursGrid"></div>
</div>

<!-- IMPRESSION -->

<div class="pane hidden" id="panePrint">
  <div class="pbar">
    <div>
      <h3 style="font-family:'Syne';font-size:15px;margin-bottom:3px">Étiquettes QR</h3>
      <p style="color:var(--mut);font-size:12px" id="pStats">0 sélectionné</p>
    </div>
    <div style="display:flex;gap:6px;flex-wrap:wrap">
      <button class="bs" id="btnSelPending">Nouveaux</button>
      <button class="bs" id="btnSelAll">Tous</button>
      <button class="bs" id="btnDesel">Aucun</button>
      <button class="bp" style="flex:0;padding:9px 14px" id="btnDoPrint">🖨 Imprimer</button>
      <button class="bs" id="btnMarkPrinted">✅ Marquer imprimés</button>
    </div>
  </div>
  <div class="pgrid" id="printGrid"></div>
</div>

<!-- CLASSEURS -->

<div class="pane hidden" id="paneClasseurs">
  <div class="cl-grid" id="clGrid"></div>
</div>

<!-- MATIÈRES -->

<div class="pane hidden" id="paneMatieres">
  <div class="mg" id="mgMat"></div>
</div>

<!-- FABs -->

<div class="fab-group">
  <button class="fab fab-print" id="fabPrint" title="Impression">🖨</button>
  <button class="fab fab-csv" id="fabCsv" title="CSV">⬇</button>
  <button class="fab fab-cam" id="fabCam" title="Caméra">📷</button>
  <button class="fab fab-add" id="fabAdd" title="Ajouter">＋</button>
</div>

<!-- POPUP LOCALISATION (slide-in depuis le bas) -->

<div class="loc-popup" id="locPopup">
  <button class="loc-x" id="btnCloseLocPopup">✕</button>
  <div id="locContent"></div>
</div>

<!-- MODAL COURS -->

<div class="ov hidden" id="ovCours">
  <div class="modal">
    <button class="modal-x" id="btnCancelCours">✕</button>
    <h2 id="mTitle">✏️ Ajouter un cours</h2>
    <div class="fg"><label>Titre *</label><input type="text" id="fTitle" placeholder="ex: Cinématique"></div>
    <div class="fg"><label>Matière *</label><select id="fMat"></select></div>
    <div class="fg"><label>Classeur *</label><select id="fCl"></select></div>
    <div class="fg">
      <label>Intercalaire *</label>
      <select id="fInter">
        <option value="">— Choisir —</option>
        <option value="01">01 — Intro</option><option value="02">02 — Cours 1</option>
        <option value="03">03 — Cours 2</option><option value="04">04 — Cours 3</option>
        <option value="05">05 — Cours 4</option><option value="06">06 — Cours 5</option>
        <option value="07">07 — Exercices</option><option value="08">08 — TD</option>
        <option value="09">09 — TP</option><option value="10">10 — Fiches</option>
        <option value="11">11 — Annales</option><option value="12">12 — Divers</option>
      </select>
    </div>
    <div class="uidbox" id="uidBox">—<small>Code généré automatiquement (permanent)</small></div>
    <div class="fg"><label>Description</label><textarea id="fDesc" rows="2" placeholder="Résumé, remarques..."></textarea></div>
    <div class="fg"><label>Date</label><input type="date" id="fDate"></div>
    <div class="macts">
      <button class="bs" id="btnCancelCours2">Annuler</button>
      <button class="bp" id="btnSaveCours">💾 Enregistrer</button>
    </div>
  </div>
</div>

<!-- MODAL QR CODE -->

<div class="ov hidden" id="ovQR">
  <div class="modal m-center">
    <button class="modal-x" id="btnCloseQR">✕</button>
    <h2 id="qrTitle">📱 QR Code</h2>
    <p id="qrSub"></p>
    <div class="qr-box" id="qrBox"></div>
    <div class="qr-lbl" id="qrLbl"></div>
    <div class="macts" style="justify-content:center;flex-wrap:wrap">
      <button class="bs" id="btnMarkOnePrinted">✅ Marquer imprimé</button>
