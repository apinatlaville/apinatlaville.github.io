rules_version = '2';

// Déployer : Firebase Console → Firestore → Règles → Coller → Publier
// ou : firebase deploy --only firestore:rules
//
// Clé canonique : request.auth.uid
// Repli e-mail pour anciennes données.
// Sous-chemins (presence/hub, etc.) via {document=**} — ne bloque pas le doc principal.

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.email == userId
        );
    }

    function isPackCreator() {
      return request.auth != null
        && resource.data.keys().hasAll(['createdBy'])
        && resource.data.createdBy.uid == request.auth.uid;
    }

    function packDoc() {
      return get(/databases/$(database)/documents/sharedPacks/$(packId)).data;
    }

    function canWritePackVersions() {
      return request.auth != null
        && (
          !packDoc().keys().hasAll(['createdBy'])
          || packDoc().createdBy.uid == request.auth.uid
        );
    }

    /** Maj collaborative : createdBy (créateur initial) doit rester inchangé. */
    function preservesPackCreator() {
      return request.auth != null
        && (
          !resource.data.keys().hasAll(['createdBy'])
          || (
            request.resource.data.keys().hasAll(['createdBy'])
            && request.resource.data.createdBy.uid == resource.data.createdBy.uid
          )
        );
    }

    match /utilisateurs/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Catalogue public de packs Rapide (contenu sans SRS)
    // Lecture : tout compte Google.
    // Création pack : auteur = soi. Nouvelle version / maj meta : tout compte auth
    // (createdBy figé). Suppression pack / versions : créateur initial uniquement
    // (legacy sans createdBy : tout compte auth).
    match /sharedPacks/{packId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy.uid == request.auth.uid;
      allow update: if isPackCreator()
        || (request.auth != null && !resource.data.keys().hasAll(['createdBy']))
        || preservesPackCreator();
      allow delete: if isPackCreator()
        || (request.auth != null && !resource.data.keys().hasAll(['createdBy']));

      match /versions/{versionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if canWritePackVersions();
      }
    }
  }
}
