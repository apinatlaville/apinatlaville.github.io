rules_version = '2';

// Déployer : Firebase Console → Firestore → Règles → Coller → Publier
// ou : firebase deploy --only firestore:rules
//
// Clé canonique : request.auth.uid
// Repli e-mail pour anciennes données.
// Sous-chemins (presence/hub, etc.) via {document=**} — ne bloque pas le doc principal.

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.email == userId
        );
    }

    match /utilisateurs/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Catalogue public de packs Rapide (contenu sans SRS) — tout compte Google
    match /sharedPacks/{packId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.createdBy.uid == request.auth.uid;

      match /versions/{versionId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }
  }
}
