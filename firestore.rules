rules_version = '2';

// Déployer : Firebase Console → Firestore → Règles → Coller → Publier
// ou : firebase deploy --only firestore:rules
//
// Clé canonique du document : request.auth.uid (compte Google)
// L'accès par e-mail est conservé temporairement pour la migration des anciennes données.
// Sous-collection presence/ : hub multi-appareils (Principal / Secondaire).

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.token.email == userId
        );
    }

    match /utilisateurs/{userId} {
      allow read, write: if isOwner(userId);

      match /presence/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
